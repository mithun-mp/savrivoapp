---
import MainLayout from '../layouts/MainLayout.astro';
import SearchBar from '../components/search/SearchBar';
import ProductGrid from '../components/product/ProductGrid';
import GuideCard from '../components/guide/GuideCard';
import CircularProductShowcase from '../components/home/CircularProductShowcase';
import AffiliateDisclosure from '../components/ui/AffiliateDisclosure';
import BrandLogo from '../components/ui/BrandLogo';
import { url } from '../lib/paths';
import { API_BASE } from '../lib/api';
import { selectShowcaseProducts } from '../lib/showcase-selection';
import { CONTROLLED_PRODUCT_SNAPSHOT } from '../lib/products.data';
import type { Category, Product, Guide, Offer } from '../types';
import {
  ArrowRight,
  ShieldCheck,
  Search,
  Sparkles,
  ExternalLink,
  Cpu,
  Home,
  BookOpen,
  Dumbbell,
  ShoppingBag,
  Gamepad2,
  Tag,
  CheckCircle2,
} from 'lucide-react';

// Gracefully fetch data at build time — fall back to empty array on network timeout
let categories: Category[] = [];
let featuredProducts: Product[] = [];
let recentProducts: Product[] = [];
let guides: Guide[] = [];
let activeOffers: Offer[] = [];

async function safeFetch<T>(endpoint: string): Promise<T[]> {
  try {
    const res = await fetch(endpoint, { signal: AbortSignal.timeout(5000) });
    if (!res.ok) return [];
    const json = await res.json();
    return json.data || [];
  } catch {
    return [];
  }
}

try {
  [categories, featuredProducts, recentProducts, guides, activeOffers] = await Promise.all([
    safeFetch<Category>(`${API_BASE}/categories`),
    safeFetch<Product>(`${API_BASE}/products?featured=true&limit=8`),
    safeFetch<Product>(`${API_BASE}/products?limit=8`),
    safeFetch<Guide>(`${API_BASE}/guides?limit=3`),
    safeFetch<Offer>(`${API_BASE}/offers?limit=4`),
  ]);
} catch {}

// Combine live products with snapshot to guarantee resilience and deterministic items
const allAvailableProducts = [...recentProducts];
for (const p of CONTROLLED_PRODUCT_SNAPSHOT) {
  if (!allAvailableProducts.some((ap) => ap.slug === p.slug)) {
    allAvailableProducts.push(p);
  }
}
const showcaseResult = selectShowcaseProducts(allAvailableProducts);
const showcaseProducts = showcaseResult.all;

const topPick = featuredProducts.length > 0 ? featuredProducts[0] : (showcaseProducts[0] || null);

// Category icons map for quick rail
const categoryIcons: Record<string, any> = {
  electronics: Cpu,
  home: Home,
  lifestyle: Sparkles,
  books: BookOpen,
  fitness: Dumbbell,
  fashion: ShoppingBag,
  gaming: Gamepad2,
};
---

<MainLayout
  title="SAVRIVO — Smart Finds. Better Choices."
  description="Discover, research, and compare curated products across trusted Indian retailers. Unbiased product discovery and smart shopping recommendations."
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "SAVRIVO",
    "url": "https://savrivo.in",
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "https://savrivo.in/search?q={search_term_string}" },
      "query-input": "required name=search_term_string"
    }
  }}
>
  <!-- ── HERO: SEARCH-FIRST DISCOVERY ── -->
  <section class="relative overflow-hidden py-16 md:py-24 lg:py-28" style="background: var(--color-bg)">
    <!-- Subtle ambient lighting -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div
        class="absolute -top-32 left-1/2 -translate-x-1/2 w-[800px] h-[500px] rounded-full blur-3xl opacity-20"
        style="background: radial-gradient(ellipse at center, var(--color-accent) 0%, transparent 70%)"
      ></div>
    </div>

    <div class="container-content relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
        <!-- Left: Value Proposition & Search Hub -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          {/* Identity Pill */}
          <div
            class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full w-fit mb-6 border shadow-sm animate-hero-pill"
            style="background: var(--color-surface); border-color: var(--color-border)"
          >
            <span class="w-2 h-2 rounded-full animate-pulse" style="background: var(--color-accent)"></span>
            <span class="text-xs font-bold uppercase tracking-[0.22em]" style="color: var(--color-accent)">
              Smart Finds. Better Choices.
            </span>
          </div>

          <h1
            class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.12] mb-6 tracking-tight animate-hero-heading"
            style="color: var(--color-text-1)"
          >
            Find better products.<br />
            <span style="color: var(--color-accent)">Make smarter choices.</span>
          </h1>

          <p class="text-base sm:text-lg md:text-xl leading-relaxed mb-8 max-w-xl animate-hero-subheading" style="color: var(--color-text-2)">
            SAVRIVO is India's independent multi-retailer discovery companion. We research, compare specifications, and uncover the best product recommendations across Amazon, Flipkart, and more.
          </p>

          <!-- Search Bar -->
          <div class="mb-5 max-w-xl animate-hero-search">
            <SearchBar
              client:load
              fullWidth={true}
              placeholder="Search products, brands, guides, categories…"
            />
          </div>

          <!-- Quick Discovery Tags -->
          <div class="flex flex-wrap items-center gap-2 text-xs mb-8 animate-hero-tags" style="color: var(--color-text-2)">
            <span class="font-semibold uppercase tracking-wider text-[11px]">Popular:</span>
            {['Audio', 'Smartphones', 'Home Coffee', 'Ergonomics', 'Fitness'].map((term) => (
              <a
                href={url(`/search?q=${encodeURIComponent(term)}`)}
                class="px-2.5 py-1 rounded-lg border transition-all btn-tactile hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
                style="background: var(--color-surface); border-color: var(--color-border)"
              >
                {term}
              </a>
            ))}
          </div>

          <!-- Direct CTAs -->
          <div class="flex flex-wrap items-center gap-3.5 animate-hero-cta">
            <a
              href={url('/products')}
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm sm:text-base font-bold text-white transition-all btn-tactile hover:brightness-105 shadow-sm"
              style="background: var(--color-accent)"
            >
              <span>Explore All Products</span>
              <ArrowRight size={16} />
            </a>
            <a
              href={url('/guides')}
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm sm:text-base font-semibold border transition-all btn-tactile hover:bg-[var(--color-surface-subtle)]"
              style="border-color: var(--color-border); color: var(--color-text-1); background: var(--color-surface)"
            >
              <span>Read Buying Guides</span>
            </a>
          </div>
        </div>

        <!-- Right: Animated Circular Product Showcase (Desktop) & Compact Carousel (Mobile) -->
        <div class="lg:col-span-5 w-full flex justify-center animate-hero-spotlight">
          <CircularProductShowcase client:load products={showcaseProducts} />
        </div>
      </div>
    </div>
  </section>

  <!-- ── TRUST PILLARS: HOW SAVRIVO WORKS ── -->
  <section class="section" style="background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border)">
    <div class="container-content">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
        {[
          {
            step: '01',
            title: 'Unbiased Research',
            desc: 'We independently evaluate specifications, user sentiment, and performance without retailer sponsorship.',
          },
          {
            step: '02',
            title: 'Transparent Comparison',
            desc: 'Explore clear pros, cons, technical details, and direct retailer availability across trusted platforms in India.',
          },
          {
            step: '03',
            title: 'Buy at the Official Store',
            desc: 'Choose your preferred retailer and check out directly on Amazon.in, Flipkart, or brand store.',
          },
        ].map(({ step, title, desc }) => (
          <div class="flex flex-col gap-3">
            <span class="text-3xl font-display font-extrabold" style="color: var(--color-accent); opacity: 0.5">
              {step}
            </span>
            <h3 class="font-display text-lg font-bold" style="color: var(--color-text-1)">
              {title}
            </h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-2)">
              {desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CATEGORY NAVIGATION RAIL ── -->
  {categories.length > 0 && (
    <section class="section">
      <div class="container-content">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-xs md:text-sm font-bold uppercase tracking-widest mb-1.5" style="color: var(--color-accent)">
              Directory
            </p>
            <h2 class="font-display text-2xl md:text-3xl lg:text-4xl font-extrabold tracking-tight" style="color: var(--color-text-1)">
              Browse by Department
            </h2>
          </div>
          <a
            href={url('/categories')}
            class="text-xs sm:text-sm font-bold flex items-center gap-1 hover:underline underline-offset-2"
            style="color: var(--color-accent)"
          >
            <span>All Departments</span>
            <ArrowRight size={14} />
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3.5 sm:gap-4">
          {categories.slice(0, 7).map((cat) => {
            const Icon = categoryIcons[cat.slug] || Cpu;
            return (
              <a
                href={url(`/category/${cat.slug}`)}
                class="group flex flex-col items-center gap-3 p-4 sm:p-5 rounded-2xl text-center transition-all duration-200 card-hover border"
                style="background: var(--color-surface); border-color: var(--color-border)"
              >
                <div
                  class="w-12 h-12 rounded-xl flex items-center justify-center transition-transform duration-200 group-hover:scale-110"
                  style="background: var(--color-accent-badge); color: var(--color-accent)"
                >
                  <Icon size={22} aria-hidden="true" />
                </div>
                <span class="text-xs sm:text-sm font-bold leading-tight" style="color: var(--color-text-1)">
                  {cat.name}
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ── EDITOR'S PICKS (FEATURED) ── -->
  {featuredProducts.length > 0 && (
    <section class="section" style="background: var(--color-surface); border-top: 1px solid var(--color-border)">
      <div class="container-content">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-xs md:text-sm font-bold uppercase tracking-widest mb-1.5" style="color: var(--color-accent)">
              Curated Picks
            </p>
            <h2 class="font-display text-2xl md:text-3xl lg:text-4xl font-extrabold tracking-tight" style="color: var(--color-text-1)">
              Editor's Choice
            </h2>
          </div>
          <a
            href={url('/products?featured=true')}
            class="text-xs sm:text-sm font-bold flex items-center gap-1 hover:underline underline-offset-2"
            style="color: var(--color-accent)"
          >
            <span>See all picks</span>
            <ArrowRight size={14} />
          </a>
        </div>

        <ProductGrid
          products={featuredProducts}
          gridClassName="grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-7"
        />
      </div>
    </section>
  )}

  <!-- ── TRENDING DISCOVERIES ── -->
  {recentProducts.length > 0 && (
    <section class="section">
      <div class="container-content">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-xs md:text-sm font-bold uppercase tracking-widest mb-1.5" style="color: var(--color-accent)">
              Latest Finds
            </p>
            <h2 class="font-display text-2xl md:text-3xl lg:text-4xl font-extrabold tracking-tight" style="color: var(--color-text-1)">
              Trending Products
            </h2>
          </div>
          <a
            href={url('/products')}
            class="text-xs sm:text-sm font-bold flex items-center gap-1 hover:underline underline-offset-2"
            style="color: var(--color-accent)"
          >
            <span>Explore catalog</span>
            <ArrowRight size={14} />
          </a>
        </div>

        <ProductGrid
          products={recentProducts}
          gridClassName="grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-7"
        />
      </div>
    </section>
  )}

  <!-- ── EDITORIAL BUYING GUIDES ── -->
  {guides.length > 0 && (
    <section class="section" style="background: var(--color-surface); border-top: 1px solid var(--color-border)">
      <div class="container-content">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-xs md:text-sm font-bold uppercase tracking-widest mb-1.5" style="color: var(--color-accent)">
              Expert Guides
            </p>
            <h2 class="font-display text-2xl md:text-3xl lg:text-4xl font-extrabold tracking-tight" style="color: var(--color-text-1)">
              Shopping & Buying Guides
            </h2>
          </div>
          <a
            href={url('/guides')}
            class="text-xs sm:text-sm font-bold flex items-center gap-1 hover:underline underline-offset-2"
            style="color: var(--color-accent)"
          >
            <span>All guides</span>
            <ArrowRight size={14} />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7">
          {guides.map((g) => (
            <GuideCard guide={g} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── DEALS & OFFERS TEASER ── -->
  <section class="section">
    <div class="container-content">
      <div
        class="max-w-3xl mx-auto rounded-3xl p-8 sm:p-12 text-center border relative overflow-hidden"
        style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-md)"
      >
        <!-- Subtle Ambient Flare -->
        <div
          class="absolute -top-20 -right-20 w-48 h-48 rounded-full blur-2xl opacity-15 pointer-events-none"
          style="background: var(--color-accent)"
          aria-hidden="true"
        ></div>

        <!-- Precision S Aperture Graphic -->
        <div class="mx-auto mb-6 w-16 h-16 flex items-center justify-center">
          <BrandLogo client:load size={56} showWordmark={false} />
        </div>

        <p class="text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--color-accent)">
          Retailer Offers & Deals
        </p>
        <h2 class="font-display text-2xl sm:text-3xl font-extrabold mb-4" style="color: var(--color-text-1)">
          Compare Verified Retailer Offers
        </h2>
        <p class="text-sm sm:text-base leading-relaxed mb-8 max-w-lg mx-auto" style="color: var(--color-text-2)">
          We track verified promotional offers, coupon codes, and verified products across authorized Indian retail feeds.
        </p>

        <a
          href={url('/offers')}
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl font-bold text-sm sm:text-base text-white transition-all hover:brightness-105 active:scale-[0.98] shadow-sv-sm"
          style="background: var(--color-accent)"
        >
          <span>Explore Verified Deals</span>
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ── AFFILIATE DISCLOSURE ── -->
  <section class="pb-16">
    <div class="container-content max-w-3xl">
      <AffiliateDisclosure />
    </div>
  </section>
</MainLayout>
