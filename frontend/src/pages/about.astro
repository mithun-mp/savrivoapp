---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb';
import { url } from '../lib/paths';
import { ShieldCheck, Search, ShoppingBag, Sparkles, ArrowRight, CheckCircle2 } from 'lucide-react';
---

<MainLayout
  title="About SAVRIVO — Smart Finds. Better Choices."
  description="Learn what SAVRIVO is, how our independent product discovery works, and our transparent affiliate revenue model."
  canonicalUrl="https://savrivo.in/about"
>
  <div class="section py-8 sm:py-14">
    <div class="container-content max-w-4xl">
      {/* Breadcrumb Navigation */}
      <div class="mb-8">
        <Breadcrumb
          client:load
          items={[
            { label: 'Home', href: '/' },
            { label: 'About' },
          ]}
        />
      </div>

      {/* Hero Header */}
      <div class="mb-12 pb-8 border-b" style={{ borderColor: 'var(--color-border)' }}>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-4"
          style="background: var(--color-accent-badge); color: var(--color-accent-badge-text); border: 1px solid var(--color-border)">
          <Sparkles size={13} />
          <span>The SAVRIVO Mission</span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-4" style="color: var(--color-text-1)">
          Smart Finds. Better Choices.
        </h1>

        <p class="text-base sm:text-xl leading-relaxed max-w-2xl" style="color: var(--color-text-2)">
          SAVRIVO is an independent product discovery platform for India. We help conscious consumers cut through marketplace clutter and find genuinely great gear.
        </p>
      </div>

      {/* 3 Core Discovery Pillars */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div
          class="p-6 rounded-2xl border"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
        >
          <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4"
            style="background: var(--color-accent-badge); color: var(--color-accent)">
            <Search size={20} />
          </div>
          <h3 class="font-display text-base font-bold mb-2" style="color: var(--color-text-1)">
            1. Pure Research
          </h3>
          <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--color-text-2)">
            No paid brand placements. We evaluate products based on durability, authentic specifications, and community feedback.
          </p>
        </div>

        <div
          class="p-6 rounded-2xl border"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
        >
          <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4"
            style="background: var(--color-accent-badge); color: var(--color-accent)">
            <ShieldCheck size={20} />
          </div>
          <h3 class="font-display text-base font-bold mb-2" style="color: var(--color-text-1)">
            2. Verified Links
          </h3>
          <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--color-text-2)">
            We direct you strictly to authorized retailer product pages on Amazon India, Flipkart, and official store channels.
          </p>
        </div>

        <div
          class="p-6 rounded-2xl border"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
        >
          <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4"
            style="background: var(--color-accent-badge); color: var(--color-accent)">
            <ShoppingBag size={20} />
          </div>
          <h3 class="font-display text-base font-bold mb-2" style="color: var(--color-text-1)">
            3. Zero Cart Friction
          </h3>
          <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--color-text-2)">
            We never hold your money, process credit cards, or manage returns. All purchases complete securely at the official merchant.
          </p>
        </div>
      </div>

      {/* Main Narrative Content */}
      <div class="space-y-10">
        {/* What is SAVRIVO */}
        <section
          class="p-6 sm:p-8 rounded-2xl border"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
        >
          <h2 class="font-display text-xl sm:text-2xl font-bold mb-4" style="color: var(--color-text-1)">
            What is SAVRIVO?
          </h2>
          <p class="text-sm sm:text-base leading-relaxed mb-4" style="color: var(--color-text-2)">
            SAVRIVO is an independent product discovery platform for India. We help you discover curated products across trusted retailers — think of us as your research companion, not a store.
          </p>
          <div
            class="p-4 rounded-xl border text-sm leading-relaxed"
            style="background: var(--color-overlay); border-color: var(--color-border); color: var(--color-text-1);"
          >
            <strong>SAVRIVO is not an e-commerce store.</strong> We do not sell products, accept payments, process orders, handle deliveries, or manage returns. All transactions happen directly on the retailer's official website.
          </div>
        </section>

        {/* How Product Discovery Works */}
        <section
          class="p-6 sm:p-8 rounded-2xl border"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
        >
          <h2 class="font-display text-xl sm:text-2xl font-bold mb-5" style="color: var(--color-text-1)">
            How Product Discovery Works
          </h2>
          <div class="space-y-4">
            <div class="flex items-start gap-4 p-4 rounded-xl" style="background: var(--color-overlay)">
              <div class="w-8 h-8 rounded-full font-bold flex items-center justify-center shrink-0 text-white text-sm"
                style="background: var(--color-accent)">
                1
              </div>
              <div>
                <h4 class="font-bold text-sm mb-1" style="color: var(--color-text-1)">We research</h4>
                <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--color-text-2)">
                  Our editorial team selects and documents products based on category relevance and usefulness — not paid placements.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-xl" style="background: var(--color-overlay)">
              <div class="w-8 h-8 rounded-full font-bold flex items-center justify-center shrink-0 text-white text-sm"
                style="background: var(--color-accent)">
                2
              </div>
              <div>
                <h4 class="font-bold text-sm mb-1" style="color: var(--color-text-1)">You discover</h4>
                <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--color-text-2)">
                  Browse, filter, and read about products in one place with consistent, honest information and side-by-side specs.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-xl" style="background: var(--color-overlay)">
              <div class="w-8 h-8 rounded-full font-bold flex items-center justify-center shrink-0 text-white text-sm"
                style="background: var(--color-accent)">
                3
              </div>
              <div>
                <h4 class="font-bold text-sm mb-1" style="color: var(--color-text-1)">You buy at the official store</h4>
                <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--color-text-2)">
                  Clicking "Shop Now" takes you directly to the retailer's official product page. We are transparent about which retailer you are visiting.
                </p>
              </div>
            </div>
          </div>
        </section>

        {/* Independence & Revenue */}
        <section
          class="p-6 sm:p-8 rounded-2xl border"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
        >
          <h2 class="font-display text-xl sm:text-2xl font-bold mb-4" style="color: var(--color-text-1)">
            Our Independence & How We Earn Revenue
          </h2>
          <p class="text-sm sm:text-base leading-relaxed mb-4" style="color: var(--color-text-2)">
            SAVRIVO is editorially independent. We are not affiliated with, owned by, or endorsed by Amazon, Flipkart, or any other retailer. Our affiliate relationships are disclosed on every relevant page.
          </p>
          <p class="text-sm sm:text-base leading-relaxed mb-5" style="color: var(--color-text-2)">
            SAVRIVO participates in affiliate programmes such as Amazon Associates. When you click a link and make a qualifying purchase, we may earn a small commission at no extra cost to you. This commission supports our editorial work and keeps the platform free to use.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href={url('/affiliate-disclosure')}
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold hover:underline"
              style="color: var(--color-accent)"
            >
              <span>Read Full Affiliate Disclosure</span>
              <ArrowRight size={14} />
            </a>
            <span class="text-xs" style="color: var(--color-border)">•</span>
            <a
              href={url('/editorial-policy')}
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold hover:underline"
              style="color: var(--color-accent)"
            >
              <span>Editorial Policy</span>
              <ArrowRight size={14} />
            </a>
          </div>
        </section>

        {/* Contact CTA */}
        <div
          class="p-6 sm:p-8 rounded-2xl border flex flex-col sm:flex-row sm:items-center justify-between gap-6"
          style="background: var(--color-overlay); border-color: var(--color-border);"
        >
          <div>
            <h3 class="font-display text-lg font-bold mb-1" style="color: var(--color-text-1)">
              Have questions or feedback?
            </h3>
            <p class="text-xs sm:text-sm" style="color: var(--color-text-2)">
              We welcome suggestions, corrections, and product category requests.
            </p>
          </div>
          <a
            href={url('/contact')}
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-bold text-white transition-opacity hover:opacity-90 shadow-sv-sm shrink-0 min-h-[44px]"
            style="background: var(--color-accent)"
          >
            <span>Contact Our Team</span>
            <ArrowRight size={15} />
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

