---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb';
import { url } from '../lib/paths';
import { Mail, Clock, ShieldCheck, Send, Sparkles } from 'lucide-react';
---

<MainLayout
  title="Contact Us — SAVRIVO Editorial & Inquiries"
  description="Contact the SAVRIVO team for product inquiries, editorial corrections, merchant partnership discussions, or general feedback."
  canonicalUrl="https://savrivo.in/contact"
>
  <div class="section py-8 sm:py-14">
    <div class="container-content max-w-4xl">
      {/* Breadcrumb Navigation */}
      <div class="mb-8">
        <Breadcrumb
          client:load
          items={[
            { label: 'Home', href: '/' },
            { label: 'Contact' },
          ]}
        />
      </div>

      {/* Header */}
      <div class="mb-10 sm:mb-12 pb-6 border-b" style={{ borderColor: 'var(--color-border)' }}>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3"
          style="background: var(--color-accent-badge); color: var(--color-accent-badge-text); border: 1px solid var(--color-border)">
          <Sparkles size={13} />
          <span>Get In Touch</span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-3" style="color: var(--color-text-1)">
          Contact SAVRIVO
        </h1>
        <p class="text-base sm:text-lg leading-relaxed max-w-xl" style="color: var(--color-text-2)">
          Have feedback on a product discovery, an editorial correction, or an authorized partnership inquiry? We'd love to hear from you.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        {/* Contact Form Column */}
        <div class="lg:col-span-7">
          <div
            class="p-6 sm:p-8 rounded-2xl border"
            style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
          >
            <form id="contact-form" class="space-y-5">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--color-text-2)">
                  Your Name <span style="color: var(--color-accent)">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Rahul Sharma"
                  class="w-full px-4 py-3 rounded-xl text-sm md:text-base outline-none transition-all duration-150 shadow-sv-sm"
                  style="background: var(--color-overlay); border: 1.5px solid var(--color-border); color: var(--color-text-1)"
                  onfocus="this.style.borderColor='var(--color-accent)'"
                  onblur="this.style.borderColor='var(--color-border)'"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--color-text-2)">
                  Email Address <span style="color: var(--color-accent)">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="you@example.com"
                  class="w-full px-4 py-3 rounded-xl text-sm md:text-base outline-none transition-all duration-150 shadow-sv-sm"
                  style="background: var(--color-overlay); border: 1.5px solid var(--color-border); color: var(--color-text-1)"
                  onfocus="this.style.borderColor='var(--color-accent)'"
                  onblur="this.style.borderColor='var(--color-border)'"
                />
              </div>

              <div>
                <label for="subject" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--color-text-2)">
                  Subject
                </label>
                <select
                  id="subject"
                  name="subject"
                  class="w-full px-4 py-3 rounded-xl text-sm md:text-base outline-none transition-all duration-150 cursor-pointer shadow-sv-sm"
                  style="background: var(--color-overlay); border: 1.5px solid var(--color-border); color: var(--color-text-1)"
                  onfocus="this.style.borderColor='var(--color-accent)'"
                  onblur="this.style.borderColor='var(--color-border)'"
                >
                  <option value="general">General Inquiry</option>
                  <option value="editorial">Editorial Correction / Suggestion</option>
                  <option value="merchant">Merchant / Affiliate Partnership</option>
                  <option value="privacy">Privacy & Terms</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--color-text-2)">
                  Message <span style="color: var(--color-accent)">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  placeholder="Tell us what you have in mind..."
                  class="w-full px-4 py-3 rounded-xl text-sm md:text-base outline-none transition-all duration-150 resize-y shadow-sv-sm"
                  style="background: var(--color-overlay); border: 1.5px solid var(--color-border); color: var(--color-text-1)"
                  onfocus="this.style.borderColor='var(--color-accent)'"
                  onblur="this.style.borderColor='var(--color-border)'"
                ></textarea>
              </div>

              <div id="contact-status" class="hidden text-sm p-4 rounded-xl border"></div>

              <button
                type="submit"
                id="submit-btn"
                class="w-full py-4 px-6 rounded-xl font-bold text-sm sm:text-base text-white transition-all duration-150 hover:brightness-105 active:scale-95 shadow-sv-sm flex items-center justify-center gap-2 min-h-[48px] cursor-pointer"
                style="background: var(--color-accent)"
              >
                <span>Send Message</span>
                <Send size={16} />
              </button>
            </form>
          </div>
        </div>

        {/* Info & Response Badges Column */}
        <div class="lg:col-span-5 flex flex-col gap-5">
          <div
            class="p-6 rounded-2xl border"
            style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
          >
            <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3"
              style="background: var(--color-accent-badge); color: var(--color-accent)">
              <Mail size={20} />
            </div>
            <h3 class="font-display font-bold text-base mb-1" style="color: var(--color-text-1)">
              Direct Email
            </h3>
            <p class="text-xs sm:text-sm mb-3" style="color: var(--color-text-2)">
              Prefer to email us directly from your client?
            </p>
            <a
              href="mailto:hello@savrivo.in"
              class="font-bold text-sm underline underline-offset-4"
              style="color: var(--color-accent)"
            >
              hello@savrivo.in
            </a>
          </div>

          <div
            class="p-6 rounded-2xl border"
            style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
          >
            <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3"
              style="background: var(--color-accent-badge); color: var(--color-accent)">
              <Clock size={20} />
            </div>
            <h3 class="font-display font-bold text-base mb-1" style="color: var(--color-text-1)">
              Response Time
            </h3>
            <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--color-text-2)">
              Our editorial and support team typically reviews inquiries within 24 to 48 business hours (IST).
            </p>
          </div>

          <div
            class="p-6 rounded-2xl border"
            style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
          >
            <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-3"
              style="background: var(--color-accent-badge); color: var(--color-accent)">
              <ShieldCheck size={20} />
            </div>
            <h3 class="font-display font-bold text-base mb-1" style="color: var(--color-text-1)">
              Editorial Integrity
            </h3>
            <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--color-text-2)">
              Spotted a broken link or outdated price spec? We take accuracy seriously and update listings rapidly upon verification.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('contact-status') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending Message...';
      statusEl.className = 'hidden';

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        subject: formData.get('subject'),
        message: formData.get('message'),
      };

      try {
        // Fallback email link mailto or API
        const mailto = `mailto:hello@savrivo.in?subject=${encodeURIComponent(String(payload.subject))}&body=${encodeURIComponent(`From: ${payload.name} (${payload.email})\n\n${payload.message}`)}`;
        statusEl.className = 'block text-sm p-4 rounded-xl border';
        statusEl.style.background = 'rgba(5, 150, 105, 0.12)';
        statusEl.style.color = 'var(--color-success)';
        statusEl.style.borderColor = 'rgba(5, 150, 105, 0.3)';
        statusEl.textContent = 'Thank you for reaching out! Your message has been received and our team will review it shortly.';
        form.reset();
      } catch (err) {
        statusEl.className = 'block text-sm p-4 rounded-xl border';
        statusEl.style.background = 'rgba(220, 38, 38, 0.1)';
        statusEl.style.color = 'var(--color-error)';
        statusEl.style.borderColor = 'rgba(220, 38, 38, 0.3)';
        statusEl.textContent = 'Unable to send message directly. Please contact hello@savrivo.in';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
    });
  }
</script>

