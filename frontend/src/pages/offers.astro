---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb';
import BrandLogo from '../components/ui/BrandLogo';
import { url } from '../lib/paths';
import { ArrowRight, ShieldCheck, Sparkles, CheckCircle2 } from 'lucide-react';
---

<MainLayout
  title="Live Verified Offers — Coming Soon | SAVRIVO"
  description="Real-time multi-merchant offer discovery is coming to SAVRIVO. We are building an authentic, verified price comparison experience for Indian shoppers."
  canonicalUrl="https://savrivo.in/offers"
>
  <div class="section py-8 sm:py-16">
    <div class="container-content max-w-3xl">
      {/* Breadcrumb Navigation */}
      <div class="mb-8">
        <Breadcrumb
          client:load
          items={[
            { label: 'Home', href: '/' },
            { label: 'Live Offers' },
          ]}
        />
      </div>

      <div class="text-center py-6 sm:py-10">
        {/* Precision S Brand Symbol */}
        <div class="mx-auto mb-8 w-20 h-20 sm:w-24 sm:h-24 flex items-center justify-center rounded-3xl border shadow-sv-sm"
          style="background: var(--color-surface); border-color: var(--color-border);">
          <BrandLogo client:load size={48} showWordmark={false} />
        </div>

        <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4"
          style="background: var(--color-accent-badge); color: var(--color-accent-badge-text); border: 1px solid var(--color-border)">
          <Sparkles size={13} />
          <span>Real-Time Retailer Comparison</span>
        </div>

        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-5" style="color: var(--color-text-1)">
          Live Offer Discovery
        </h1>

        <p class="text-base sm:text-lg leading-relaxed mb-8 max-w-xl mx-auto" style="color: var(--color-text-2)">
          We are engineering a verified engine to compare live pricing, merchant stock, and promotional deals across trusted Indian retailers.
        </p>

        {/* Commitment Card */}
        <div
          class="p-6 sm:p-8 rounded-2xl border text-left mb-10 max-w-2xl mx-auto"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
        >
          <div class="flex items-center gap-2 mb-4 font-display font-bold text-base" style="color: var(--color-text-1)">
            <ShieldCheck size={18} class="text-[var(--color-accent)]" />
            <span>Our Verification Commitment</span>
          </div>

          <p class="text-xs sm:text-sm leading-relaxed mb-5" style="color: var(--color-text-2)">
            SAVRIVO only displays verified pricing and retailer data sourced directly through authorized affiliate APIs and merchant feeds. We strictly prohibit fake countdown timers, artificial discounts, and misleading markup calculations.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs" style="color: var(--color-text-1)">
            <div class="flex items-center gap-2">
              <CheckCircle2 size={15} class="text-[var(--color-accent)] shrink-0" />
              <span>Real INR prices directly from stores</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 size={15} class="text-[var(--color-accent)] shrink-0" />
              <span>Amazon India & Flipkart verified feeds</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 size={15} class="text-[var(--color-accent)] shrink-0" />
              <span>Zero hidden commission fees</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 size={15} class="text-[var(--color-accent)] shrink-0" />
              <span>Direct links with no redirects</span>
            </div>
          </div>
        </div>

        <a
          href={url('/products')}
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl text-sm font-bold text-white transition-all duration-150 hover:brightness-105 active:scale-95 shadow-sv-sm min-h-[44px]"
          style="background: var(--color-accent)"
        >
          <span>Explore Curated Products</span>
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </div>
</MainLayout>

