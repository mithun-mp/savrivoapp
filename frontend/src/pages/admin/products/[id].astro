---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { url } from '../../../lib/paths';

export async function getStaticPaths() {
  return [{ params: { id: 'edit' } }];
}
---

<AdminLayout title="Edit Product">
  <div class="max-w-3xl space-y-8 pb-12">
    <!-- Breadcrumb & Header -->
    <div>
      <a
        href={url('/admin/products')}
        class="inline-flex items-center gap-1.5 text-xs font-semibold hover:text-[var(--color-accent)] transition-colors mb-3"
        style="color: var(--color-text-2)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
        Back to Products
      </a>
      <h1 class="text-2xl font-bold font-display" style="color: var(--color-text-1)">Edit Product</h1>
      <p class="text-xs mt-1" style="color: var(--color-text-2)">Update product details, status, media, and editorial highlights.</p>
    </div>

    <!-- Loading State -->
    <div id="product-loading" class="p-12 text-center rounded-2xl border" style="background: var(--color-surface); border-color: var(--color-border)">
      <div class="flex items-center justify-center gap-2">
        <svg class="w-5 h-5 animate-spin text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        <span class="text-sm font-medium" style="color: var(--color-text-2)">Loading product details...</span>
      </div>
    </div>

    <form id="edit-product-form" class="space-y-6 hidden">
      <!-- Section 1: Core Information -->
      <div class="p-6 sm:p-7 rounded-2xl border space-y-5" style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)">
        <div class="flex items-center gap-2 pb-2 border-b" style="border-color: var(--color-border)">
          <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7h-9M14 17H5M14 12H5M20 12h-2M20 17h-2"/></svg>
          <h2 class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-1)">Core Information</h2>
        </div>

        <div>
          <label for="title" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Product Title *</label>
          <input
            type="text"
            id="title"
            required
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="brand" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Brand *</label>
            <input
              type="text"
              id="brand"
              required
              class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
              style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
            />
          </div>
          <div>
            <label for="categoryId" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Category</label>
            <select
              id="categoryId"
              class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] cursor-pointer"
              style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
            >
              <option value="">Select Category</option>
            </select>
          </div>
          <div>
            <label for="status" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Status</label>
            <select
              id="status"
              class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] cursor-pointer"
              style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
            >
              <option value="draft">Draft (Private)</option>
              <option value="published">Published (Live)</option>
              <option value="archived">Archived (Hidden)</option>
            </select>
          </div>
        </div>

        <div>
          <label for="shortDescription" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Short Description</label>
          <textarea
            id="shortDescription"
            rows="2"
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          ></textarea>
        </div>

        <div>
          <label for="fullDescription" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Full Description (HTML)</label>
          <textarea
            id="fullDescription"
            rows="5"
            class="w-full px-4 py-2.5 rounded-xl border text-xs font-mono outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          ></textarea>
        </div>

        <div class="pt-2">
          <label class="flex items-center gap-2.5 cursor-pointer">
            <input type="checkbox" id="featured" class="w-4 h-4 rounded text-[var(--color-accent)] focus:ring-[var(--color-accent)]/20" />
            <span class="text-sm font-semibold" style="color: var(--color-text-1)">Feature as Editor's Pick</span>
          </label>
        </div>
      </div>

      <!-- Section 2: Media & Highlights -->
      <div class="p-6 sm:p-7 rounded-2xl border space-y-5" style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)">
        <div class="flex items-center gap-2 pb-2 border-b" style="border-color: var(--color-border)">
          <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <h2 class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-1)">Media & Highlights</h2>
        </div>

        <div>
          <label for="imageUrl" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Main Image URL</label>
          <input
            type="url"
            id="imageUrl"
            placeholder="https://images.unsplash.com/..."
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          />
        </div>

        <div>
          <label for="highlights" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Key Highlights (one per line)</label>
          <textarea
            id="highlights"
            rows="3"
            placeholder="Custom 40mm carbon dynamic drivers&#10;Active Noise Cancellation with ambient awareness&#10;30-hour battery life with fast charging"
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          ></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="tags" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Tags (comma-separated)</label>
            <input
              type="text"
              id="tags"
              placeholder="anc, wireless, premium-audio"
              class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
              style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
            />
          </div>
          <div>
            <label for="canonicalUrl" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Canonical URL (Optional)</label>
            <input
              type="url"
              id="canonicalUrl"
              placeholder="https://savrivo.in/product/..."
              class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
              style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
            />
          </div>
        </div>
      </div>

      <div id="form-msg" class="hidden text-xs p-4 rounded-xl font-medium"></div>

      <div class="flex items-center gap-3 pt-2">
        <button
          type="submit"
          id="save-btn"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm text-white transition-all hover:opacity-95 active:scale-95 shadow-sm min-h-[44px]"
          style="background: var(--color-accent)"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Update Product
        </button>
        <a
          href={url('/admin/products')}
          class="px-5 py-3 rounded-xl border text-sm font-semibold transition-colors hover:bg-[var(--color-overlay)] min-h-[44px] inline-flex items-center justify-center"
          style="border-color: var(--color-border); color: var(--color-text-2)"
        >
          Back
        </a>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  import { api } from '../../../lib/api';

  const pathParts = window.location.pathname.split('/');
  const idFromPath = pathParts[pathParts.length - 1] || pathParts[pathParts.length - 2];
  const urlParams = new URLSearchParams(window.location.search);
  const productId = urlParams.get('id') || (idFromPath !== 'edit' ? idFromPath : '');

  const loadingEl = document.getElementById('product-loading') as HTMLDivElement;
  const form = document.getElementById('edit-product-form') as HTMLFormElement;
  const msgEl = document.getElementById('form-msg') as HTMLDivElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  async function init() {
    if (!productId) {
      if (loadingEl) {
        loadingEl.innerHTML = '<p class="text-sm" style="color: var(--color-error)">No product ID specified.</p>';
      }
      return;
    }

    try {
      // 1. Fetch categories
      const catRes: any = await api.admin.categories.list().catch(() => ({ data: [] }));
      const catSelect = document.getElementById('categoryId') as HTMLSelectElement;
      if (catSelect && catRes.data) {
        catSelect.innerHTML = '<option value="">Select Category</option>' +
          catRes.data.map((c: any) => `<option value="${c._id}">${c.name}</option>`).join('');
      }

      // 2. Fetch product by ID
      const res: any = await api.admin.products.get(productId);
      const p = res.data;
      if (!p) throw new Error('Product record not found');

      (document.getElementById('title') as HTMLInputElement).value = p.title || '';
      (document.getElementById('brand') as HTMLInputElement).value = p.brand || '';
      if (p.categoryId?._id || p.categoryId) {
        (document.getElementById('categoryId') as HTMLSelectElement).value = p.categoryId._id || p.categoryId;
      }
      (document.getElementById('shortDescription') as HTMLTextAreaElement).value = p.shortDescription || '';
      (document.getElementById('fullDescription') as HTMLTextAreaElement).value = p.fullDescription || '';
      (document.getElementById('status') as HTMLSelectElement).value = p.status || 'draft';
      (document.getElementById('featured') as HTMLInputElement).checked = !!p.featured;

      if (p.images && p.images.length > 0 && p.images[0].url) {
        (document.getElementById('imageUrl') as HTMLInputElement).value = p.images[0].url;
      }
      if (p.highlights && Array.isArray(p.highlights)) {
        (document.getElementById('highlights') as HTMLTextAreaElement).value = p.highlights.join('\n');
      }
      if (p.tags && Array.isArray(p.tags)) {
        (document.getElementById('tags') as HTMLInputElement).value = p.tags.join(', ');
      }
      if (p.canonicalUrl) {
        (document.getElementById('canonicalUrl') as HTMLInputElement).value = p.canonicalUrl;
      }

      loadingEl?.classList.add('hidden');
      form?.classList.remove('hidden');
    } catch (err: any) {
      if (loadingEl) {
        loadingEl.innerHTML = `<p class="text-sm font-semibold" style="color: var(--color-error)">Failed to load product: ${err.message || 'Unknown error'}</p>`;
      }
    }
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!productId) return;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Updating...';
      msgEl.className = 'hidden';

      const imageUrl = (document.getElementById('imageUrl') as HTMLInputElement).value.trim();
      const rawHighlights = (document.getElementById('highlights') as HTMLTextAreaElement).value;
      const highlights = rawHighlights.split('\n').map(s => s.trim()).filter(Boolean);
      const rawTags = (document.getElementById('tags') as HTMLInputElement).value;
      const tags = rawTags.split(',').map(s => s.trim()).filter(Boolean);
      const canonicalUrl = (document.getElementById('canonicalUrl') as HTMLInputElement).value.trim();
      const categoryId = (document.getElementById('categoryId') as HTMLSelectElement).value;

      const updateData: Record<string, unknown> = {
        title: (document.getElementById('title') as HTMLInputElement).value.trim(),
        brand: (document.getElementById('brand') as HTMLInputElement).value.trim(),
        shortDescription: (document.getElementById('shortDescription') as HTMLTextAreaElement).value.trim(),
        fullDescription: (document.getElementById('fullDescription') as HTMLTextAreaElement).value.trim(),
        status: (document.getElementById('status') as HTMLSelectElement).value,
        featured: (document.getElementById('featured') as HTMLInputElement).checked,
        categoryId: categoryId || undefined,
        canonicalUrl: canonicalUrl || undefined,
        highlights,
        tags,
      };

      if (imageUrl) {
        updateData.images = [{ url: imageUrl, alt: updateData.title as string }];
      }

      try {
        const res: any = await api.admin.products.update(productId, updateData);
        if (res.success || res.data) {
          msgEl.className = 'block text-xs p-4 rounded-xl font-medium';
          msgEl.style.background = 'rgba(5, 150, 105, 0.12)';
          msgEl.style.border = '1px solid rgba(5, 150, 105, 0.25)';
          msgEl.style.color = 'var(--color-success)';
          msgEl.textContent = 'Product updated successfully!';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          throw new Error(res.message || 'Update failed');
        }
      } catch (err: any) {
        msgEl.className = 'block text-xs p-4 rounded-xl font-medium';
        msgEl.style.background = 'rgba(220, 38, 38, 0.1)';
        msgEl.style.border = '1px solid rgba(220, 38, 38, 0.25)';
        msgEl.style.color = 'var(--color-error)';
        msgEl.textContent = err.message || 'Update failed';
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Update Product';
      }
    });
  }

  init();
</script>
