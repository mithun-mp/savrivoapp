---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/paths';
---

<Base title="Admin Login — SAVRIVO" noindex={true}>
  <div class="min-h-screen flex items-center justify-center p-4" style="background: var(--color-bg)">
    <div
      class="w-full max-w-md p-8 sm:p-10 rounded-2xl"
      style="background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--shadow-lg)"
    >
      <div class="text-center mb-8">
        <a href={url('/')} class="inline-flex items-center gap-2.5 font-bold tracking-[0.2em] text-base mb-4 group" style="color: var(--color-accent)">
          <svg width="32" height="32" viewBox="0 0 64 64" fill="none" aria-hidden="true" class="shrink-0 transition-transform group-hover:scale-105">
            <path
              d="M48 11L53 16C53 16 51 25 43 28L21 36C13 39 11 48 11 48L16 53C24 53 35 53 45 47C53 42 53 33 53 33M16 53L11 48C11 48 13 39 21 36L43 28C51 25 53 16 53 16L48 11C40 11 29 11 19 17C11 22 11 31 11 31"
              stroke="var(--color-accent)"
              stroke-width="6.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <polygon points="32,24 38,32 32,40 26,32" fill="var(--color-accent)" />
          </svg>
          <span class="font-display tracking-[0.22em] font-extrabold text-xl" style="color: var(--color-text-1)">SAVRIVO</span>
        </a>
        <h1 class="text-2xl font-bold font-display" style="color: var(--color-text-1)">Editorial Portal</h1>
        <p class="text-xs mt-1.5" style="color: var(--color-text-2)">Authorized editorial personnel only. Multi-factor protected.</p>
      </div>

      <form id="admin-login-form" class="space-y-5">
        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">
            Admin Email
          </label>
          <input
            type="email"
            id="email"
            required
            autocomplete="email"
            placeholder="admin@savrivo.in"
            class="w-full px-4 py-3 rounded-xl text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border: 1.5px solid var(--color-border); color: var(--color-text-1)"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">
            Password
          </label>
          <input
            type="password"
            id="password"
            required
            autocomplete="current-password"
            placeholder="••••••••••••"
            class="w-full px-4 py-3 rounded-xl text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border: 1.5px solid var(--color-border); color: var(--color-text-1)"
          />
        </div>

        <div id="login-error" class="hidden text-xs p-3.5 rounded-xl font-medium" style="background: rgba(220, 38, 38, 0.1); border: 1px solid rgba(220, 38, 38, 0.25); color: var(--color-error)"></div>

        <button
          type="submit"
          id="login-btn"
          class="w-full py-3.5 px-6 rounded-xl font-semibold text-sm text-white transition-all hover:opacity-95 active:scale-[0.99] shadow-sm flex items-center justify-center gap-2"
          style="background: var(--color-accent)"
        >
          Sign In to Dashboard
        </button>
      </form>

      <div class="mt-8 pt-6 border-t text-center" style="border-color: var(--color-border)">
        <a href={url('/')} class="text-xs font-medium hover:underline inline-flex items-center gap-1.5" style="color: var(--color-text-2)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Return to SAVRIVO Catalog
        </a>
      </div>
    </div>
  </div>
</Base>

<script>
  import { api } from '../../lib/api';
  import { url } from '../../lib/paths';

  const form = document.getElementById('admin-login-form') as HTMLFormElement;
  const errorEl = document.getElementById('login-error') as HTMLDivElement;
  const btn = document.getElementById('login-btn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Verifying...';
      if (errorEl) errorEl.className = 'hidden';

      const email = (document.getElementById('email') as HTMLInputElement).value.trim().toLowerCase();
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const res = await api.admin.login(email, password);
        if (res.data?.token) {
          localStorage.setItem('savrivo-admin-token', res.data.token);
          localStorage.setItem('savrivo-admin-email', res.data.user.email);
          window.location.href = url('/admin');
        } else {
          throw new Error(res.message || 'Login failed');
        }
      } catch (err: any) {
        if (errorEl) {
          errorEl.className = 'block text-xs p-3.5 rounded-xl font-medium';
          errorEl.textContent = err.message || 'Invalid credentials or server unavailable';
        }
      } finally {
        btn.disabled = false;
        btn.textContent = 'Sign In to Dashboard';
      }
    });
  }
</script>

