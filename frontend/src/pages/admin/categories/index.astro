---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Category Management">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-2xl font-bold font-display" style="color: var(--color-text-1)">Categories</h1>
        <p class="text-xs mt-1" style="color: var(--color-text-2)">Create and organize curated product categories.</p>
      </div>
      <button
        id="add-cat-btn"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-95 active:scale-95 shadow-sm min-h-[44px] self-start sm:self-auto"
        style="background: var(--color-accent)"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        <span>Add Category</span>
      </button>
    </div>

    <!-- Create Modal / Inline Form -->
    <div id="cat-form-box" class="hidden p-6 sm:p-7 rounded-2xl border space-y-4" style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)">
      <div class="flex items-center gap-2 pb-2 border-b" style="border-color: var(--color-border)">
        <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3.85 8.62 4.9-4.9a2 2 0 0 1 2.83 0l8.48 8.48a2 2 0 0 1 0 2.83l-4.9 4.9a2 2 0 0 1-2.83 0L3.85 11.45a2 2 0 0 1 0-2.83Z"/><path d="m14 7 3 3"/></svg>
        <h2 class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-1)">Add New Category</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="cat-name" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Name *</label>
          <input
            type="text"
            id="cat-name"
            placeholder="e.g. Home & Kitchen"
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          />
        </div>
        <div>
          <label for="cat-icon" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Icon Name (Lucide)</label>
          <input
            type="text"
            id="cat-icon"
            placeholder="e.g. Home, Cpu, Sparkles"
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          />
        </div>
      </div>

      <div>
        <label for="cat-desc" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Description</label>
        <textarea
          id="cat-desc"
          rows="2"
          placeholder="Brief category scope and editorial focus..."
          class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        ></textarea>
      </div>

      <div class="flex gap-2 pt-2">
        <button
          id="cat-save-btn"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-95 active:scale-95 shadow-sm min-h-[44px]"
          style="background: var(--color-accent)"
        >
          Save Category
        </button>
        <button
          id="cat-cancel-btn"
          class="px-5 py-2.5 rounded-xl border text-sm font-semibold transition-colors hover:bg-[var(--color-overlay)] min-h-[44px]"
          style="border-color: var(--color-border); color: var(--color-text-2)"
        >
          Cancel
        </button>
      </div>
    </div>

    <!-- Table -->
    <div class="rounded-2xl border overflow-hidden" style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[600px]">
          <thead>
            <tr class="border-b text-[11px] font-bold uppercase tracking-wider" style="background: var(--color-overlay); border-color: var(--color-border); color: var(--color-text-2)">
              <th class="py-3.5 px-5">Name</th>
              <th class="py-3.5 px-4">Slug</th>
              <th class="py-3.5 px-4">Description</th>
              <th class="py-3.5 px-5 text-right">Status</th>
            </tr>
          </thead>
          <tbody id="cat-tbody">
            <tr>
              <td colspan="4" class="p-8 text-center text-xs" style="color: var(--color-text-2)">
                <div class="flex items-center justify-center gap-2">
                  <svg class="w-4 h-4 animate-spin text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                  <span>Loading categories...</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from '../../../lib/api';

  async function load() {
    const tbody = document.getElementById('cat-tbody');
    try {
      const res: any = await api.admin.categories.list();
      const list = res.data || [];
      if (!tbody) return;
      if (list.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="4" class="p-12 text-center">
              <div class="flex flex-col items-center justify-center gap-2">
                <p class="text-sm font-medium" style="color: var(--color-text-2)">No categories found</p>
                <p class="text-xs" style="color: var(--color-text-3)">Click "+ Add Category" to create the first category.</p>
              </div>
            </td>
          </tr>
        `;
        return;
      }
      tbody.innerHTML = list.map((c: any) => `
        <tr class="border-b transition-colors hover:bg-[var(--color-overlay)]" style="border-color: var(--color-border)">
          <td class="py-3.5 px-5 font-semibold text-sm" style="color: var(--color-text-1)">${c.name}</td>
          <td class="py-3.5 px-4 font-mono text-xs" style="color: var(--color-accent)">${c.slug}</td>
          <td class="py-3.5 px-4 text-xs" style="color: var(--color-text-2)">${c.description || '—'}</td>
          <td class="py-3.5 px-5 text-right">
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-1 rounded-full" style="${c.active !== false ? 'background: rgba(5, 150, 105, 0.12); color: var(--color-success); border: 1px solid rgba(5, 150, 105, 0.25)' : 'background: rgba(100, 116, 139, 0.12); color: var(--color-text-3); border: 1px solid rgba(100, 116, 139, 0.25)'}">
              ${c.active !== false ? 'Active' : 'Inactive'}
            </span>
          </td>
        </tr>
      `).join('');
    } catch {
      if (tbody) tbody.innerHTML = '<tr><td colspan="4" class="p-8 text-center text-xs" style="color: var(--color-error)">Failed to load categories. Check server connection.</td></tr>';
    }
  }

  const box = document.getElementById('cat-form-box');
  document.getElementById('add-cat-btn')?.addEventListener('click', () => box?.classList.remove('hidden'));
  document.getElementById('cat-cancel-btn')?.addEventListener('click', () => box?.classList.add('hidden'));

  document.getElementById('cat-save-btn')?.addEventListener('click', async () => {
    const name = (document.getElementById('cat-name') as HTMLInputElement).value;
    const icon = (document.getElementById('cat-icon') as HTMLInputElement).value;
    const description = (document.getElementById('cat-desc') as HTMLTextAreaElement).value;
    if (!name) return;

    await api.admin.categories.create({ name, icon, description });
    box?.classList.add('hidden');
    (document.getElementById('cat-name') as HTMLInputElement).value = '';
    (document.getElementById('cat-icon') as HTMLInputElement).value = '';
    (document.getElementById('cat-desc') as HTMLTextAreaElement).value = '';
    load();
  });

  load();
</script>

