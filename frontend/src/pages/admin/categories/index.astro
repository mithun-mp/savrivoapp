---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Category Management">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-2xl font-bold font-display" style="color: var(--color-text-1)">Categories</h1>
        <p class="text-xs mt-1" style="color: var(--color-text-2)">Create, organize, and edit curated product categories.</p>
      </div>
      <button
        id="add-cat-btn"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-95 active:scale-95 shadow-sm min-h-[44px] self-start sm:self-auto"
        style="background: var(--color-accent)"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        <span id="add-cat-btn-label">Add Category</span>
      </button>
    </div>

    <!-- Create / Edit Form Box -->
    <div id="cat-form-box" class="hidden p-6 sm:p-7 rounded-2xl border space-y-4" style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)">
      <div class="flex items-center justify-between pb-2 border-b" style="border-color: var(--color-border)">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3.85 8.62 4.9-4.9a2 2 0 0 1 2.83 0l8.48 8.48a2 2 0 0 1 0 2.83l-4.9 4.9a2 2 0 0 1-2.83 0L3.85 11.45a2 2 0 0 1 0-2.83Z"/><path d="m14 7 3 3"/></svg>
          <h2 id="cat-form-title" class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-1)">Add New Category</h2>
        </div>
        <input type="hidden" id="cat-edit-id" value="" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="cat-name" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Name *</label>
          <input
            type="text"
            id="cat-name"
            placeholder="e.g. Home & Kitchen"
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          />
        </div>
        <div>
          <label for="cat-icon" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Icon Name (Lucide)</label>
          <input
            type="text"
            id="cat-icon"
            placeholder="e.g. Home, Cpu, Sparkles"
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="cat-order" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Display Order</label>
          <input
            type="number"
            id="cat-order"
            placeholder="0"
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          />
        </div>
        <div>
          <label for="cat-active" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Status</label>
          <select
            id="cat-active"
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] cursor-pointer"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          >
            <option value="true">Active (Visible)</option>
            <option value="false">Inactive (Hidden)</option>
          </select>
        </div>
      </div>

      <div>
        <label for="cat-desc" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Description</label>
        <textarea
          id="cat-desc"
          rows="2"
          placeholder="Brief category scope and editorial focus..."
          class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        ></textarea>
      </div>

      <div id="cat-error-msg" class="hidden text-xs p-3 rounded-xl font-medium" style="background: rgba(220, 38, 38, 0.1); border: 1px solid rgba(220, 38, 38, 0.25); color: var(--color-error)"></div>

      <div class="flex gap-2 pt-2">
        <button
          id="cat-save-btn"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-95 active:scale-95 shadow-sm min-h-[44px]"
          style="background: var(--color-accent)"
        >
          Save Category
        </button>
        <button
          id="cat-cancel-btn"
          class="px-5 py-2.5 rounded-xl border text-sm font-semibold transition-colors hover:bg-[var(--color-overlay)] min-h-[44px]"
          style="border-color: var(--color-border); color: var(--color-text-2)"
        >
          Cancel
        </button>
      </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="flex items-center gap-3 p-4 rounded-2xl border" style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)">
      <div class="relative flex-1 min-w-[200px]">
        <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color: var(--color-text-3)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input
          type="text"
          id="cat-search"
          placeholder="Filter categories by name or slug..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        />
      </div>
    </div>

    <!-- Table -->
    <div class="rounded-2xl border overflow-hidden" style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[650px]">
          <thead>
            <tr class="border-b text-[11px] font-bold uppercase tracking-wider" style="background: var(--color-overlay); border-color: var(--color-border); color: var(--color-text-2)">
              <th class="py-3.5 px-5">Name</th>
              <th class="py-3.5 px-4">Slug</th>
              <th class="py-3.5 px-4">Description</th>
              <th class="py-3.5 px-4">Status</th>
              <th class="py-3.5 px-5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="cat-tbody">
            <tr>
              <td colspan="5" class="p-8 text-center text-xs" style="color: var(--color-text-2)">
                <div class="flex items-center justify-center gap-2">
                  <svg class="w-4 h-4 animate-spin text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                  <span>Loading categories...</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from '../../../lib/api';

  let rawCategories: any[] = [];

  function renderTable(list: any[]) {
    const tbody = document.getElementById('cat-tbody');
    if (!tbody) return;

    if (list.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="p-12 text-center">
            <div class="flex flex-col items-center justify-center gap-2">
              <p class="text-sm font-medium" style="color: var(--color-text-2)">No categories found</p>
              <p class="text-xs" style="color: var(--color-text-3)">Click "+ Add Category" to create the first category.</p>
            </div>
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = list.map((c: any) => `
      <tr class="border-b transition-colors hover:bg-[var(--color-overlay)]" style="border-color: var(--color-border)">
        <td class="py-3.5 px-5 font-semibold text-sm" style="color: var(--color-text-1)">${c.name}</td>
        <td class="py-3.5 px-4 font-mono text-xs" style="color: var(--color-accent)">${c.slug}</td>
        <td class="py-3.5 px-4 text-xs" style="color: var(--color-text-2)">${c.description || '—'}</td>
        <td class="py-3.5 px-4">
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-1 rounded-full" style="${c.active !== false ? 'background: rgba(5, 150, 105, 0.12); color: var(--color-success); border: 1px solid rgba(5, 150, 105, 0.25)' : 'background: rgba(100, 116, 139, 0.12); color: var(--color-text-3); border: 1px solid rgba(100, 116, 139, 0.25)'}">
            ${c.active !== false ? 'Active' : 'Inactive'}
          </span>
        </td>
        <td class="py-3.5 px-5 text-right space-x-2">
          <button
            data-edit-id="${c._id}"
            class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1.5 rounded-lg border transition-colors hover:bg-[var(--color-overlay)]"
            style="border-color: var(--color-border); color: var(--color-accent)"
            title="Edit category"
          >
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
            <span>Edit</span>
          </button>
          <button
            data-delete-id="${c._id}"
            class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1.5 rounded-lg border transition-colors hover:bg-red-500/10"
            style="border-color: var(--color-border); color: var(--color-error)"
            title="Delete category"
          >
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
            <span>Delete</span>
          </button>
        </td>
      </tr>
    `).join('');

    // Wire edit buttons
    document.querySelectorAll('[data-edit-id]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-edit-id');
        const c = rawCategories.find(item => item._id === id);
        if (!c) return;

        (document.getElementById('cat-edit-id') as HTMLInputElement).value = c._id;
        (document.getElementById('cat-name') as HTMLInputElement).value = c.name || '';
        (document.getElementById('cat-icon') as HTMLInputElement).value = c.icon || '';
        (document.getElementById('cat-desc') as HTMLTextAreaElement).value = c.description || '';
        (document.getElementById('cat-order') as HTMLInputElement).value = c.displayOrder ? String(c.displayOrder) : '0';
        (document.getElementById('cat-active') as HTMLSelectElement).value = c.active !== false ? 'true' : 'false';

        const titleEl = document.getElementById('cat-form-title');
        if (titleEl) titleEl.textContent = 'Edit Category: ' + c.name;
        const saveBtn = document.getElementById('cat-save-btn');
        if (saveBtn) saveBtn.textContent = 'Update Category';

        box?.classList.remove('hidden');
        box?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    // Wire delete buttons
    document.querySelectorAll('[data-delete-id]').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-delete-id');
        const c = rawCategories.find(item => item._id === id);
        const name = c ? c.name : 'this category';
        if (id && confirm(`Delete category "${name}"? This action cannot be undone.`)) {
          try {
            await api.admin.categories.delete(id);
            load();
          } catch (err: any) {
            alert('Failed to delete category: ' + (err.message || 'Error'));
          }
        }
      });
    });
  }

  async function load() {
    const tbody = document.getElementById('cat-tbody');
    try {
      const res: any = await api.admin.categories.list();
      rawCategories = res.data || [];
      renderTable(rawCategories);
    } catch {
      if (tbody) tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-xs" style="color: var(--color-error)">Failed to load categories. Check server connection.</td></tr>';
    }
  }

  // Filter search
  const searchInput = document.getElementById('cat-search') as HTMLInputElement;
  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.toLowerCase().trim();
    if (!q) {
      renderTable(rawCategories);
      return;
    }
    const filtered = rawCategories.filter(c =>
      (c.name && c.name.toLowerCase().includes(q)) ||
      (c.slug && c.slug.toLowerCase().includes(q)) ||
      (c.description && c.description.toLowerCase().includes(q))
    );
    renderTable(filtered);
  });

  const box = document.getElementById('cat-form-box');
  const errorEl = document.getElementById('cat-error-msg');
  const saveBtn = document.getElementById('cat-save-btn') as HTMLButtonElement;

  function resetForm() {
    (document.getElementById('cat-edit-id') as HTMLInputElement).value = '';
    (document.getElementById('cat-name') as HTMLInputElement).value = '';
    (document.getElementById('cat-icon') as HTMLInputElement).value = '';
    (document.getElementById('cat-desc') as HTMLTextAreaElement).value = '';
    (document.getElementById('cat-order') as HTMLInputElement).value = '0';
    (document.getElementById('cat-active') as HTMLSelectElement).value = 'true';

    const titleEl = document.getElementById('cat-form-title');
    if (titleEl) titleEl.textContent = 'Add New Category';
    if (saveBtn) saveBtn.textContent = 'Save Category';
    if (errorEl) {
      errorEl.classList.add('hidden');
      errorEl.textContent = '';
    }
  }

  document.getElementById('add-cat-btn')?.addEventListener('click', () => {
    resetForm();
    box?.classList.toggle('hidden');
  });

  document.getElementById('cat-cancel-btn')?.addEventListener('click', () => {
    resetForm();
    box?.classList.add('hidden');
  });

  saveBtn?.addEventListener('click', async () => {
    const editId = (document.getElementById('cat-edit-id') as HTMLInputElement).value;
    const name = (document.getElementById('cat-name') as HTMLInputElement).value.trim();
    const icon = (document.getElementById('cat-icon') as HTMLInputElement).value.trim();
    const description = (document.getElementById('cat-desc') as HTMLTextAreaElement).value.trim();
    const displayOrderVal = (document.getElementById('cat-order') as HTMLInputElement).value.trim();
    const active = (document.getElementById('cat-active') as HTMLSelectElement).value === 'true';

    if (!name) {
      if (errorEl) {
        errorEl.textContent = 'Category Name is required.';
        errorEl.classList.remove('hidden');
      }
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = editId ? 'Updating...' : 'Saving...';
    if (errorEl) errorEl.classList.add('hidden');

    try {
      const payload: Record<string, unknown> = {
        name,
        icon: icon || undefined,
        description: description || undefined,
        displayOrder: displayOrderVal ? Number(displayOrderVal) : 0,
        active,
      };

      if (editId) {
        await api.admin.categories.update(editId, payload);
      } else {
        await api.admin.categories.create(payload);
      }

      resetForm();
      box?.classList.add('hidden');
      load();
    } catch (err: any) {
      if (errorEl) {
        errorEl.textContent = err.message || 'Failed to save category.';
        errorEl.classList.remove('hidden');
      }
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = editId ? 'Update Category' : 'Save Category';
    }
  });

  load();
</script>
