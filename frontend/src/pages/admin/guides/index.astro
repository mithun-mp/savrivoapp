---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { url } from '../../../lib/paths';
---

<AdminLayout title="Buying Guide Management">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2">
      <div>
        <h1 class="text-2xl font-bold font-display" style="color: var(--color-text-1)">Buying Guides</h1>
        <p class="text-xs mt-1" style="color: var(--color-text-2)">Create, edit, and publish research-backed purchase and evaluation guides.</p>
      </div>
      <button
        id="add-guide-btn"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-95 active:scale-95 shadow-sm min-h-[44px] self-start sm:self-auto"
        style="background: var(--color-accent)"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        <span id="add-guide-btn-label">New Guide</span>
      </button>
    </div>

    <!-- Guide Form Box (Create / Edit) -->
    <div id="guide-form-box" class="hidden p-6 sm:p-7 rounded-2xl border space-y-4" style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)">
      <div class="flex items-center justify-between pb-2 border-b" style="border-color: var(--color-border)">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10M6 10h10"/></svg>
          <h2 id="g-form-title" class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-1)">Write New Buying Guide</h2>
        </div>
        <input type="hidden" id="g-edit-id" value="" />
      </div>

      <div>
        <label for="g-title" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Title *</label>
        <input
          type="text"
          id="g-title"
          placeholder="e.g. How to Choose Wireless Earbuds in India (2025)"
          class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="g-category" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Category</label>
          <input
            type="text"
            id="g-category"
            placeholder="e.g. Electronics"
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          />
        </div>
        <div>
          <label for="g-status" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Status</label>
          <select
            id="g-status"
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] cursor-pointer"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          >
            <option value="draft">Draft (Private)</option>
            <option value="published">Published (Live)</option>
            <option value="archived">Archived (Hidden)</option>
          </select>
        </div>
        <div>
          <label for="g-cover" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Cover Image URL</label>
          <input
            type="url"
            id="g-cover"
            placeholder="https://images.unsplash.com/..."
            class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
            style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
          />
        </div>
      </div>

      <div>
        <label for="g-excerpt" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Excerpt / Overview</label>
        <textarea
          id="g-excerpt"
          rows="2"
          placeholder="Brief summary to display in article listings and social previews..."
          class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        ></textarea>
      </div>

      <div>
        <label for="g-body" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">Body Content (HTML)</label>
        <textarea
          id="g-body"
          rows="6"
          placeholder="Editorial article content with HTML formatting..."
          class="w-full px-4 py-2.5 rounded-xl border text-xs font-mono outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        ></textarea>
      </div>

      <div id="g-error-msg" class="hidden text-xs p-3 rounded-xl font-medium" style="background: rgba(220, 38, 38, 0.1); border: 1px solid rgba(220, 38, 38, 0.25); color: var(--color-error)"></div>

      <div class="flex gap-2 pt-2">
        <button
          id="g-save-btn"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-95 active:scale-95 shadow-sm min-h-[44px]"
          style="background: var(--color-accent)"
        >
          Save Guide
        </button>
        <button
          id="g-cancel-btn"
          class="px-5 py-2.5 rounded-xl border text-sm font-semibold transition-colors hover:bg-[var(--color-overlay)] min-h-[44px]"
          style="border-color: var(--color-border); color: var(--color-text-2)"
        >
          Cancel
        </button>
      </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="flex items-center gap-3 p-4 rounded-2xl border" style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)">
      <div class="relative flex-1 min-w-[200px]">
        <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color: var(--color-text-3)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input
          type="text"
          id="guide-search"
          placeholder="Filter guides by title or category..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        />
      </div>
    </div>

    <!-- Table -->
    <div class="rounded-2xl border overflow-hidden" style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[650px]">
          <thead>
            <tr class="border-b text-[11px] font-bold uppercase tracking-wider" style="background: var(--color-overlay); border-color: var(--color-border); color: var(--color-text-2)">
              <th class="py-3.5 px-5">Title</th>
              <th class="py-3.5 px-4">Category</th>
              <th class="py-3.5 px-4">Status</th>
              <th class="py-3.5 px-4">Published Date</th>
              <th class="py-3.5 px-5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="guides-tbody">
            <tr>
              <td colspan="5" class="p-8 text-center text-xs" style="color: var(--color-text-2)">
                <div class="flex items-center justify-center gap-2">
                  <svg class="w-4 h-4 animate-spin text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                  <span>Loading guides...</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from '../../../lib/api';
  import { url } from '../../../lib/paths';

  let rawGuides: any[] = [];

  function renderTable(list: any[]) {
    const tbody = document.getElementById('guides-tbody');
    if (!tbody) return;

    if (list.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" class="p-12 text-center">
            <div class="flex flex-col items-center justify-center gap-2">
              <p class="text-sm font-medium" style="color: var(--color-text-2)">No guides match criteria</p>
              <p class="text-xs" style="color: var(--color-text-3)">Click "+ New Guide" to draft a research-backed guide.</p>
            </div>
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = list.map((g: any) => `
      <tr class="border-b transition-colors hover:bg-[var(--color-overlay)]" style="border-color: var(--color-border)">
        <td class="py-3.5 px-5 font-semibold text-sm" style="color: var(--color-text-1)">
          <a href="${url('/guides/' + g.slug)}" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)] inline-flex items-center gap-1.5 group">
            <span>${g.title}</span>
            <svg class="w-3.5 h-3.5 opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </td>
        <td class="py-3.5 px-4 text-xs font-medium" style="color: var(--color-text-2)">${g.category || '—'}</td>
        <td class="py-3.5 px-4">
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-1 rounded-full" style="${g.status === 'published' ? 'background: rgba(5, 150, 105, 0.12); color: var(--color-success); border: 1px solid rgba(5, 150, 105, 0.25)' : 'background: rgba(217, 119, 6, 0.12); color: #D97706; border: 1px solid rgba(217, 119, 6, 0.25)'}">
            ${g.status}
          </span>
        </td>
        <td class="py-3.5 px-4 text-xs" style="color: var(--color-text-2)">${g.publishedAt ? new Date(g.publishedAt).toLocaleDateString() : '—'}</td>
        <td class="py-3.5 px-5 text-right space-x-2">
          <button
            data-edit-id="${g._id}"
            class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1.5 rounded-lg border transition-colors hover:bg-[var(--color-overlay)]"
            style="border-color: var(--color-border); color: var(--color-accent)"
            title="Edit guide"
          >
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
            <span>Edit</span>
          </button>
          <button
            data-delete-id="${g._id}"
            class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1.5 rounded-lg border transition-colors hover:bg-red-500/10"
            style="border-color: var(--color-border); color: var(--color-error)"
            title="Delete guide"
          >
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
            <span>Delete</span>
          </button>
        </td>
      </tr>
    `).join('');

    // Wire edit buttons
    document.querySelectorAll('[data-edit-id]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-edit-id');
        const g = rawGuides.find(item => item._id === id);
        if (!g) return;

        (document.getElementById('g-edit-id') as HTMLInputElement).value = g._id;
        (document.getElementById('g-title') as HTMLInputElement).value = g.title || '';
        (document.getElementById('g-category') as HTMLInputElement).value = g.category || '';
        (document.getElementById('g-status') as HTMLSelectElement).value = g.status || 'draft';
        (document.getElementById('g-cover') as HTMLInputElement).value = g.coverImage || '';
        (document.getElementById('g-excerpt') as HTMLTextAreaElement).value = g.excerpt || '';
        (document.getElementById('g-body') as HTMLTextAreaElement).value = g.body || '';

        const titleEl = document.getElementById('g-form-title');
        if (titleEl) titleEl.textContent = 'Edit Guide: ' + g.title;
        const saveBtn = document.getElementById('g-save-btn');
        if (saveBtn) saveBtn.textContent = 'Update Guide';

        box?.classList.remove('hidden');
        box?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    // Wire delete buttons
    document.querySelectorAll('[data-delete-id]').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-delete-id');
        const g = rawGuides.find(item => item._id === id);
        const title = g ? g.title : 'this guide';
        if (id && confirm(`Delete guide "${title}"? This action cannot be undone.`)) {
          try {
            await api.admin.guides.delete(id);
            load();
          } catch (err: any) {
            alert('Failed to delete guide: ' + (err.message || 'Error'));
          }
        }
      });
    });
  }

  async function load() {
    const tbody = document.getElementById('guides-tbody');
    try {
      const res: any = await api.admin.guides.list();
      rawGuides = res.data || [];
      renderTable(rawGuides);
    } catch {
      if (tbody) tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-xs" style="color: var(--color-error)">Failed to load guides. Check server connection.</td></tr>';
    }
  }

  // Filter search
  const searchInput = document.getElementById('guide-search') as HTMLInputElement;
  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.toLowerCase().trim();
    if (!q) {
      renderTable(rawGuides);
      return;
    }
    const filtered = rawGuides.filter(g =>
      (g.title && g.title.toLowerCase().includes(q)) ||
      (g.category && g.category.toLowerCase().includes(q))
    );
    renderTable(filtered);
  });

  const box = document.getElementById('guide-form-box');
  const errorEl = document.getElementById('g-error-msg');
  const saveBtn = document.getElementById('g-save-btn') as HTMLButtonElement;

  function resetForm() {
    (document.getElementById('g-edit-id') as HTMLInputElement).value = '';
    (document.getElementById('g-title') as HTMLInputElement).value = '';
    (document.getElementById('g-category') as HTMLInputElement).value = '';
    (document.getElementById('g-status') as HTMLSelectElement).value = 'draft';
    (document.getElementById('g-cover') as HTMLInputElement).value = '';
    (document.getElementById('g-excerpt') as HTMLTextAreaElement).value = '';
    (document.getElementById('g-body') as HTMLTextAreaElement).value = '';

    const titleEl = document.getElementById('g-form-title');
    if (titleEl) titleEl.textContent = 'Write New Buying Guide';
    if (saveBtn) saveBtn.textContent = 'Save Guide';
    if (errorEl) {
      errorEl.classList.add('hidden');
      errorEl.textContent = '';
    }
  }

  document.getElementById('add-guide-btn')?.addEventListener('click', () => {
    resetForm();
    box?.classList.toggle('hidden');
  });

  document.getElementById('g-cancel-btn')?.addEventListener('click', () => {
    resetForm();
    box?.classList.add('hidden');
  });

  saveBtn?.addEventListener('click', async () => {
    const editId = (document.getElementById('g-edit-id') as HTMLInputElement).value;
    const title = (document.getElementById('g-title') as HTMLInputElement).value.trim();
    const category = (document.getElementById('g-category') as HTMLInputElement).value.trim();
    const status = (document.getElementById('g-status') as HTMLSelectElement).value;
    const coverImage = (document.getElementById('g-cover') as HTMLInputElement).value.trim();
    const excerpt = (document.getElementById('g-excerpt') as HTMLTextAreaElement).value.trim();
    const body = (document.getElementById('g-body') as HTMLTextAreaElement).value.trim();

    if (!title) {
      if (errorEl) {
        errorEl.textContent = 'Guide Title is required.';
        errorEl.classList.remove('hidden');
      }
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = editId ? 'Updating...' : 'Saving...';
    if (errorEl) errorEl.classList.add('hidden');

    try {
      const payload: Record<string, unknown> = {
        title,
        category: category || undefined,
        status,
        coverImage: coverImage || undefined,
        excerpt: excerpt || undefined,
        body: body || undefined,
        publishedAt: status === 'published' ? new Date().toISOString() : undefined,
      };

      if (editId) {
        await api.admin.guides.update(editId, payload);
      } else {
        await api.admin.guides.create(payload);
      }

      resetForm();
      box?.classList.add('hidden');
      load();
    } catch (err: any) {
      if (errorEl) {
        errorEl.textContent = err.message || 'Failed to save guide.';
        errorEl.classList.remove('hidden');
      }
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = editId ? 'Update Guide' : 'Save Guide';
    }
  });

  load();
</script>
