---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { url } from '../../lib/paths';
import { Package, CheckCircle2, FileEdit, Tags, Store, AlertTriangle, PlusCircle, ArrowRight, ExternalLink } from 'lucide-react';
---

<AdminLayout title="System Overview">
  <div class="space-y-8">
    {/* Welcome & Overview Header */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b" style={{ borderColor: 'var(--color-border)' }}>
      <div>
        <h2 class="font-display text-xl sm:text-2xl font-bold" style="color: var(--color-text-1)">
          Dashboard & Performance
        </h2>
        <p class="text-xs sm:text-sm mt-0.5" style="color: var(--color-text-2)">
          Real-time catalog metrics and affiliate operation health.
        </p>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href={url('/admin/products/new')}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-white transition-all duration-150 hover:brightness-105 active:scale-95 shadow-sv-sm min-h-[44px]"
          style="background: var(--color-accent)"
        >
          <PlusCircle size={16} />
          <span>New Product</span>
        </a>
      </div>
    </div>

    {/* Metric Stat Cards Grid */}
    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-3.5 sm:gap-4" id="stats-grid">
      {/* Total Products */}
      <div
        class="p-4 sm:p-5 rounded-2xl border transition-all duration-150 hover:shadow-sv-sm"
        style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
      >
        <div class="flex items-center justify-between mb-2">
          <p class="text-xs uppercase tracking-wider font-bold" style="color: var(--color-text-2)">Total</p>
          <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background: var(--color-overlay); color: var(--color-text-2)">
            <Package size={15} />
          </div>
        </div>
        <p class="text-2xl sm:text-3xl font-extrabold font-display tabular-nums" id="stat-total" style="color: var(--color-text-1)">—</p>
        <span class="text-[11px] font-medium" style="color: var(--color-text-2)">Active items</span>
      </div>

      {/* Published */}
      <div
        class="p-4 sm:p-5 rounded-2xl border transition-all duration-150 hover:shadow-sv-sm"
        style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
      >
        <div class="flex items-center justify-between mb-2">
          <p class="text-xs uppercase tracking-wider font-bold" style="color: var(--color-text-2)">Published</p>
          <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background: rgba(5, 150, 105, 0.12); color: var(--color-success)">
            <CheckCircle2 size={15} />
          </div>
        </div>
        <p class="text-2xl sm:text-3xl font-extrabold font-display tabular-nums" id="stat-published" style="color: var(--color-success)">—</p>
        <span class="text-[11px] font-medium" style="color: var(--color-text-2)">Live on site</span>
      </div>

      {/* Drafts */}
      <div
        class="p-4 sm:p-5 rounded-2xl border transition-all duration-150 hover:shadow-sv-sm"
        style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
      >
        <div class="flex items-center justify-between mb-2">
          <p class="text-xs uppercase tracking-wider font-bold" style="color: var(--color-text-2)">Drafts</p>
          <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background: rgba(217, 119, 6, 0.12); color: #D97706">
            <FileEdit size={15} />
          </div>
        </div>
        <p class="text-2xl sm:text-3xl font-extrabold font-display tabular-nums" id="stat-drafts" style="color: #D97706">—</p>
        <span class="text-[11px] font-medium" style="color: var(--color-text-2)">Under review</span>
      </div>

      {/* Categories */}
      <div
        class="p-4 sm:p-5 rounded-2xl border transition-all duration-150 hover:shadow-sv-sm"
        style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
      >
        <div class="flex items-center justify-between mb-2">
          <p class="text-xs uppercase tracking-wider font-bold" style="color: var(--color-text-2)">Categories</p>
          <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background: var(--color-overlay); color: var(--color-text-2)">
            <Tags size={15} />
          </div>
        </div>
        <p class="text-2xl sm:text-3xl font-extrabold font-display tabular-nums" id="stat-categories" style="color: var(--color-text-1)">—</p>
        <span class="text-[11px] font-medium" style="color: var(--color-text-2)">Taxonomies</span>
      </div>

      {/* Active Merchants */}
      <div
        class="p-4 sm:p-5 rounded-2xl border transition-all duration-150 hover:shadow-sv-sm"
        style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
      >
        <div class="flex items-center justify-between mb-2">
          <p class="text-xs uppercase tracking-wider font-bold" style="color: var(--color-text-2)">Merchants</p>
          <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background: var(--color-accent-badge); color: var(--color-accent)">
            <Store size={15} />
          </div>
        </div>
        <p class="text-2xl sm:text-3xl font-extrabold font-display tabular-nums" id="stat-merchants" style="color: var(--color-accent)">—</p>
        <span class="text-[11px] font-medium" style="color: var(--color-text-2)">Connected feeds</span>
      </div>

      {/* Expired Offers */}
      <div
        class="p-4 sm:p-5 rounded-2xl border transition-all duration-150 hover:shadow-sv-sm"
        style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
      >
        <div class="flex items-center justify-between mb-2">
          <p class="text-xs uppercase tracking-wider font-bold" style="color: var(--color-text-2)">Expired</p>
          <div class="w-7 h-7 rounded-lg flex items-center justify-center" style="background: rgba(220, 38, 38, 0.1); color: var(--color-error)">
            <AlertTriangle size={15} />
          </div>
        </div>
        <p class="text-2xl sm:text-3xl font-extrabold font-display tabular-nums" id="stat-expired" style="color: var(--color-error)">—</p>
        <span class="text-[11px] font-medium" style="color: var(--color-text-2)">Requires attention</span>
      </div>
    </div>

    {/* Quick Action Navigation Bar */}
    <div class="flex flex-wrap gap-2.5 sm:gap-3">
      <a
        href={url('/admin/products/new')}
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-white transition-opacity hover:opacity-90 min-h-[44px]"
        style="background: var(--color-accent)"
      >
        <PlusCircle size={15} />
        <span>Create Product</span>
      </a>
      <a
        href={url('/admin/categories')}
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border transition-colors hover:bg-[var(--color-overlay)] min-h-[44px]"
        style="border-color: var(--color-border); color: var(--color-text-1); background: var(--color-surface)"
      >
        <Tags size={15} className="text-[var(--color-accent)]" />
        <span>Manage Categories</span>
      </a>
      <a
        href={url('/admin/merchants')}
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border transition-colors hover:bg-[var(--color-overlay)] min-h-[44px]"
        style="border-color: var(--color-border); color: var(--color-text-1); background: var(--color-surface)"
      >
        <Store size={15} className="text-[var(--color-accent)]" />
        <span>Manage Merchants</span>
      </a>
      <a
        href={url('/admin/offers')}
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold border transition-colors hover:bg-[var(--color-overlay)] min-h-[44px]"
        style="border-color: var(--color-border); color: var(--color-text-1); background: var(--color-surface)"
      >
        <span class="font-bold text-xs" style="color: var(--color-accent)">%</span>
        <span>Manage Offers</span>
      </a>
    </div>

    {/* Recent Products Table */}
    <div
      class="rounded-2xl border overflow-hidden"
      style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm);"
    >
      <div class="p-5 border-b flex items-center justify-between" style="border-color: var(--color-border)">
        <div class="flex items-center gap-2">
          <Package size={17} className="text-[var(--color-accent)]" />
          <h3 class="text-sm sm:text-base font-bold font-display" style="color: var(--color-text-1)">
            Recently Added Products
          </h3>
        </div>
        <a href={url('/admin/products')} class="inline-flex items-center gap-1 text-xs font-bold hover:underline" style="color: var(--color-accent)">
          <span>View Catalog</span>
          <ArrowRight size={13} />
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm min-w-[540px]">
          <thead>
            <tr class="border-b text-[11px] uppercase tracking-wider" style="border-color: var(--color-border); color: var(--color-text-2); background: var(--color-overlay)">
              <th class="p-4 font-bold">Product Title</th>
              <th class="p-4 font-bold">Status</th>
              <th class="p-4 font-bold">Date Created</th>
              <th class="p-4 text-right font-bold">Actions</th>
            </tr>
          </thead>
          <tbody id="recent-products-tbody">
            <tr>
              <td colspan="4" class="p-8 text-center text-xs" style="color: var(--color-text-2)">
                Loading real-time catalog records...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from '../../lib/api';
  import { url } from '../../lib/paths';

  async function loadDashboard() {
    try {
      const res: any = await api.admin.dashboard();
      if (res.data) {
        const stats = res.data.stats || {};
        const setVal = (id: string, val: any) => {
          const el = document.getElementById(id);
          if (el) el.textContent = val !== undefined ? String(val) : '0';
        };
        setVal('stat-total', stats.totalProducts);
        setVal('stat-published', stats.publishedProducts);
        setVal('stat-drafts', stats.draftProducts);
        setVal('stat-categories', stats.totalCategories);
        setVal('stat-merchants', stats.activeMerchants);
        setVal('stat-expired', stats.expiredOffers);

        const tbody = document.getElementById('recent-products-tbody');
        if (tbody) {
          const recents = res.data.recentProducts || [];
          if (recents.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="p-6 text-center text-xs" style="color: var(--color-text-2)">No products found. Click "+ Create Product" to begin cataloging.</td></tr>';
          } else {
            tbody.innerHTML = recents.map((p: any) => `
              <tr class="border-b transition-colors hover:bg-[var(--color-overlay)]" style="border-color: var(--color-border)">
                <td class="p-4 font-medium" style="color: var(--color-text-1)">
                  <div class="line-clamp-1">${p.title}</div>
                </td>
                <td class="p-4">
                  <span class="inline-flex items-center text-xs font-semibold px-2.5 py-0.5 rounded-full border" style="${
                    p.status === 'published'
                      ? 'background: rgba(5, 150, 105, 0.12); color: var(--color-success); border-color: rgba(5, 150, 105, 0.25);'
                      : 'background: rgba(217, 119, 6, 0.12); color: #D97706; border-color: rgba(217, 119, 6, 0.25);'
                  }">
                    ${p.status}
                  </span>
                </td>
                <td class="p-4 text-xs tabular-nums" style="color: var(--color-text-2)">
                  ${new Date(p.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}
                </td>
                <td class="p-4 text-right">
                  <a href="${url('/admin/products/' + p._id)}" class="text-xs font-bold hover:underline" style="color: var(--color-accent)">
                    Edit Product
                  </a>
                </td>
              </tr>
            `).join('');
          }
        }
      }
    } catch (err) {
      console.error('Failed to load dashboard:', err);
    }
  }

  loadDashboard();
</script>

