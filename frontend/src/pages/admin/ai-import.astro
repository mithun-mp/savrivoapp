---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { url } from '../../lib/paths';
---

<AdminLayout title="AI Product Import Agent">
  <div class="max-w-6xl space-y-6 pb-16">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-2 border-b" style="border-color: var(--color-border)">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a
            href={url('/admin/products')}
            class="inline-flex items-center gap-1 text-xs font-semibold hover:text-[var(--color-accent)] transition-colors"
            style="color: var(--color-text-2)"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            Products
          </a>
          <span style="color: var(--color-border)">/</span>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            Automated Ingestion
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold font-display tracking-tight flex items-center gap-2.5" style="color: var(--color-text-1)">
          <span>AI Product Import Agent</span>
          <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-lg border bg-gradient-to-r from-emerald-500/20 to-teal-500/20 text-emerald-300 border-emerald-500/30">
            GEMINI-POWERED
          </span>
        </h1>
        <p class="text-xs sm:text-sm mt-1" style="color: var(--color-text-2)">
          Import e-commerce products from Amazon India, Flipkart, or generic merchants with SSRF protection, factual scraping, and Gemini structured enrichment.
        </p>
      </div>

      <!-- Gemini Project Diagnostics Trigger -->
      <button
        id="toggle-diagnostics-btn"
        type="button"
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border text-xs font-semibold transition-all hover:bg-[var(--color-overlay)] self-start md:self-auto cursor-pointer"
        style="background: var(--color-surface); border-color: var(--color-border); color: var(--color-text-1)"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span id="header-gemini-status">Gemini 3-Key Status</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
      </button>
    </div>

    <!-- Gemini Key Diagnostics Drawer / Panel (Collapsible) -->
    <div
      id="diagnostics-panel"
      class="hidden p-5 rounded-2xl border transition-all space-y-5"
      style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)"
    >
      <div class="flex items-center justify-between pb-3 border-b" style="border-color: var(--color-border)">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <h3 class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-1)">
            Gemini Two-Level Rotation Engine (Level 1: Model-First → Level 2: Project-Key)
          </h3>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="refresh-diag-btn"
            type="button"
            class="text-xs px-2.5 py-1 rounded-lg border font-medium hover:bg-[var(--color-overlay)] cursor-pointer"
            style="border-color: var(--color-border); color: var(--color-text-2)"
          >
            Refresh Telemetry
          </button>
          <button
            id="close-diag-btn"
            type="button"
            class="p-1 rounded-lg hover:bg-[var(--color-overlay)] cursor-pointer"
            style="color: var(--color-text-3)"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </div>

      <!-- Model Priority Sequence Banner -->
      <div class="p-3.5 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs" style="background: var(--color-bg); border-color: var(--color-border)">
        <div>
          <span class="font-bold uppercase tracking-wider text-[11px] block" style="color: var(--color-text-1)">Model Priority Order:</span>
          <div id="diag-model-priority-container" class="flex flex-wrap items-center gap-1.5 mt-1">
            <span class="font-mono text-zinc-400">Loading models...</span>
          </div>
        </div>
        <div class="text-[11px] text-right font-mono" style="color: var(--color-text-3)">
          <div>Last Successful: <span id="diag-last-success" class="text-emerald-400 font-bold">None</span></div>
        </div>
      </div>

      <!-- Key Slots (Level 2) -->
      <div>
        <h4 class="text-[11px] font-bold uppercase tracking-wider mb-2" style="color: var(--color-text-2)">API Key Project Slots (Level 2)</h4>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="diagnostics-slots-container">
          <div class="p-3.5 rounded-xl border flex flex-col justify-between" style="background: var(--color-bg); border-color: var(--color-border)">
            <div class="text-xs font-medium" style="color: var(--color-text-2)">Loading key diagnostics...</div>
          </div>
        </div>
      </div>

      <!-- Live Attempt Breadcrumb Trail -->
      <div class="p-3.5 rounded-xl border space-y-1.5" style="background: var(--color-bg); border-color: var(--color-border)">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold uppercase tracking-wider" style="color: var(--color-text-2)">Last Execution Breadcrumb History:</span>
          <span class="text-[10px] font-mono text-emerald-400">Real-time Failover</span>
        </div>
        <div id="diag-breadcrumb-trail" class="font-mono text-xs p-2.5 rounded-lg border bg-black/30 overflow-x-auto whitespace-nowrap text-zinc-300" style="border-color: var(--color-border)">
          No rotation history recorded yet.
        </div>
      </div>

      <p class="text-[11px]" style="color: var(--color-text-3)">
        * Model failover activates first: when a model hits a 429 rate limit or capacity constraint, the agent seamlessly attempts the next configured model on the same project key. If all models fail or a project-wide daily quota is exhausted, it rotates to the next API key.
      </p>
    </div>

    <!-- Notification Toast Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

    <!-- Mode Selector Tabs -->
    <div class="flex items-center gap-2 border-b" style="border-color: var(--color-border)">
      <button
        id="mode-tab-single"
        type="button"
        class="px-4 py-2.5 text-sm font-semibold border-b-2 border-emerald-500 text-emerald-400 transition-colors flex items-center gap-2 cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m12 8 4 4-4 4M8 12h8"/></svg>
        Single Product URL
      </button>
      <button
        id="mode-tab-bulk"
        type="button"
        class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent hover:text-[var(--color-text-1)] transition-colors flex items-center gap-2 cursor-pointer"
        style="color: var(--color-text-2)"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="8" height="8" x="3" y="3" rx="2"/><rect width="8" height="8" x="13" y="3" rx="2"/><rect width="8" height="8" x="3" y="13" rx="2"/><rect width="8" height="8" x="13" y="13" rx="2"/></svg>
        Bulk Ingestion (Batch)
      </button>
    </div>

    <!-- Input Section: Single Mode -->
    <div
      id="input-card-single"
      class="p-6 sm:p-7 rounded-2xl border space-y-4"
      style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)"
    >
      <div>
        <label for="product-url-input" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">
          Product Source URL *
        </label>
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="relative flex-1">
            <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color: var(--color-text-3)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m10 15 5-3-5-3v6Z"/></svg>
            <input
              type="url"
              id="product-url-input"
              placeholder="https://www.amazon.in/dp/... or https://www.flipkart.com/..."
              class="w-full pl-10 pr-4 py-3 rounded-xl border text-sm outline-none transition-all focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 font-mono"
              style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
            />
          </div>
          <button
            id="start-import-btn"
            type="button"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-95 active:scale-95 shadow-md cursor-pointer shrink-0 disabled:opacity-50 disabled:cursor-not-allowed"
            style="background: linear-gradient(135deg, #10b981 0%, #059669 100%)"
          >
            <svg id="btn-icon-sparkle" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            <svg id="btn-icon-spinner" class="w-4 h-4 animate-spin hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            <span id="btn-text">Extract & Enrich with AI</span>
          </button>
        </div>
      </div>

      <!-- Quick presets -->
      <div class="flex flex-wrap items-center gap-2 text-xs pt-1" style="color: var(--color-text-3)">
        <span class="font-medium">Quick samples:</span>
        <button
          type="button"
          class="preset-url-btn px-2.5 py-1 rounded-lg border hover:bg-[var(--color-overlay)] transition-colors"
          style="border-color: var(--color-border); color: var(--color-text-2)"
          data-url="https://www.amazon.in/dp/B0BDK62PDX"
        >
          Amazon India (iPhone 16)
        </button>
        <button
          type="button"
          class="preset-url-btn px-2.5 py-1 rounded-lg border hover:bg-[var(--color-overlay)] transition-colors"
          style="border-color: var(--color-border); color: var(--color-text-2)"
          data-url="https://www.flipkart.com/apple-iphone-15-black-128-gb/p/itm6ac6485515ae4?pid=MOBGTAGPNUUMGX7F"
        >
          Flipkart (iPhone 15)
        </button>
      </div>
    </div>

    <!-- Input Section: Bulk Mode -->
    <div
      id="input-card-bulk"
      class="hidden p-6 sm:p-7 rounded-2xl border space-y-4"
      style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)"
    >
      <div>
        <label for="bulk-urls-input" class="block text-xs font-bold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">
          Paste Product URLs (One per line, up to 10) *
        </label>
        <textarea
          id="bulk-urls-input"
          rows="5"
          placeholder="https://www.amazon.in/dp/B0BDK62PDX&#10;https://www.flipkart.com/product/p/itm123?pid=MOB123456"
          class="w-full p-4 rounded-xl border text-sm outline-none transition-all focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 font-mono"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        ></textarea>
        <div class="flex items-center justify-between text-xs mt-2" style="color: var(--color-text-3)">
          <span id="bulk-counter">0 / 10 URLs detected</span>
          <button
            id="start-bulk-import-btn"
            type="button"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-95 active:scale-95 shadow cursor-pointer disabled:opacity-50"
            style="background: linear-gradient(135deg, #10b981 0%, #059669 100%)"
          >
            <span>Process Bulk Batch</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Stepper Pipeline Visualizer (Progress) -->
    <div
      id="pipeline-stepper"
      class="hidden p-5 rounded-2xl border"
      style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)"
    >
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 text-xs">
        <div id="step-ssrf" class="flex items-center gap-2 p-2 rounded-lg" style="background: var(--color-bg)">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-bold text-[10px] bg-emerald-500/20 text-emerald-400">1</span>
          <span class="font-medium" style="color: var(--color-text-2)">SSRF Security</span>
        </div>
        <div id="step-scrape" class="flex items-center gap-2 p-2 rounded-lg" style="background: var(--color-bg)">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-bold text-[10px] bg-emerald-500/20 text-emerald-400">2</span>
          <span class="font-medium" style="color: var(--color-text-2)">Factual Scraping</span>
        </div>
        <div id="step-duplicate" class="flex items-center gap-2 p-2 rounded-lg" style="background: var(--color-bg)">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-bold text-[10px] bg-emerald-500/20 text-emerald-400">3</span>
          <span class="font-medium" style="color: var(--color-text-2)">Duplicate Check</span>
        </div>
        <div id="step-gemini" class="flex items-center gap-2 p-2 rounded-lg" style="background: var(--color-bg)">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-bold text-[10px] bg-emerald-500/20 text-emerald-400">4</span>
          <span class="font-medium" style="color: var(--color-text-2)">Gemini AI Enrichment</span>
        </div>
        <div id="step-ready" class="flex items-center gap-2 p-2 rounded-lg" style="background: var(--color-bg)">
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-bold text-[10px] bg-emerald-500/20 text-emerald-400">5</span>
          <span class="font-medium" style="color: var(--color-text-2)">Catalog Staging</span>
        </div>
      </div>
    </div>

    <!-- Review & Staging Workspace -->
    <div id="staging-workspace" class="hidden space-y-6">
      <!-- Quality & Integrity Signals Bar -->
      <div
        class="p-5 rounded-2xl border flex flex-col md:flex-row md:items-center justify-between gap-4"
        style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)"
      >
        <div class="flex items-center gap-4">
          <!-- Confidence Gauge -->
          <div class="flex items-center gap-3">
            <div class="relative w-12 h-12 flex items-center justify-center rounded-full border-2 border-emerald-500/40 bg-emerald-500/10">
              <span id="confidence-percentage" class="text-sm font-bold text-emerald-400 font-mono">95%</span>
            </div>
            <div>
              <div class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-1)">Confidence Score</div>
              <div id="confidence-label" class="text-xs" style="color: var(--color-text-2)">Verified factual data & specifications</div>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span id="enrichment-source-badge" class="text-xs font-semibold px-3 py-1 rounded-full border bg-emerald-500/15 text-emerald-300 border-emerald-500/30 flex items-center gap-1.5">
            <span id="enrichment-source-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span id="enrichment-source-text">Gemini Enriched</span>
          </span>
          <span id="merchant-tag" class="text-xs font-semibold px-3 py-1 rounded-full border bg-zinc-800 text-zinc-200 border-zinc-700">
            Amazon India
          </span>
          <span id="duplicate-status-badge" class="hidden text-xs font-semibold px-3 py-1 rounded-full border bg-amber-500/15 text-amber-300 border-amber-500/30">
            Duplicate Found
          </span>
          <span id="anti-bot-badge" class="hidden text-xs font-semibold px-3 py-1 rounded-full border bg-rose-500/15 text-rose-300 border-rose-500/30">
            Anti-Bot Challenged
          </span>
        </div>
      </div>

      <!-- Warning notice list (if any) -->
      <div id="warnings-banner" class="hidden p-4 rounded-xl border bg-amber-500/10 border-amber-500/25 text-amber-300 text-xs space-y-1">
        <div class="font-semibold flex items-center gap-1.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Verification Notices:
        </div>
        <ul id="warnings-list" class="list-disc list-inside space-y-0.5 pl-1"></ul>
      </div>

      <!-- Workspace Tabs -->
      <div class="flex items-center gap-2 border-b" style="border-color: var(--color-border)">
        <button
          id="tab-btn-draft"
          type="button"
          class="px-4 py-2.5 text-sm font-semibold border-b-2 border-emerald-500 text-emerald-400 transition-colors flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Catalog Editor (Live Staging)
        </button>
        <button
          id="tab-btn-images"
          type="button"
          class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent hover:text-[var(--color-text-1)] transition-colors flex items-center gap-1.5 cursor-pointer"
          style="color: var(--color-text-2)"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          Image Gallery (<span id="images-count-badge">0</span>)
        </button>
        <button
          id="tab-btn-audit"
          type="button"
          class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent hover:text-[var(--color-text-1)] transition-colors flex items-center gap-1.5 cursor-pointer"
          style="color: var(--color-text-2)"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          Raw Factual Extraction
        </button>
      </div>

      <!-- Tab Content: Catalog Editor Form -->
      <form id="staging-form" class="space-y-6">
        <!-- Section 1: Core Catalog Metadata -->
        <div
          id="tab-panel-draft"
          class="p-6 sm:p-7 rounded-2xl border space-y-5"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)"
        >
          <div class="flex items-center gap-2 pb-2 border-b" style="border-color: var(--color-border)">
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7h-9M14 17H5M14 12H5M20 12h-2M20 17h-2"/></svg>
            <h2 class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-1)">Product Catalog Identity</h2>
          </div>

          <div>
            <label for="edit-title" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">
              Curated Title *
            </label>
            <input
              type="text"
              id="edit-title"
              required
              class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 font-medium"
              style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="edit-slug" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">
                Catalog Slug *
              </label>
              <input
                type="text"
                id="edit-slug"
                required
                class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-emerald-500 font-mono"
                style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
              />
            </div>
            <div>
              <label for="edit-brand" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">
                Brand *
              </label>
              <input
                type="text"
                id="edit-brand"
                required
                class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-emerald-500"
                style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
              />
            </div>
            <div>
              <label for="edit-category" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">
                Primary Category
              </label>
              <select
                id="edit-category"
                class="w-full px-4 py-2.5 rounded-xl border text-sm outline-none transition-all focus:border-emerald-500 cursor-pointer"
                style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
              >
                <option value="">Select Category...</option>
              </select>
            </div>
          </div>

          <!-- Descriptions -->
          <div class="space-y-4">
            <div>
              <label for="edit-short-desc" class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--color-text-1)">
                Short Value Proposition (Hook)
              </label>
              <textarea
                id="edit-short-desc"
                rows="2"
