          </div>

          <!-- SEO & Meta -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <div class="flex items-center justify-between mb-2">
                <label for="edit-seo-title" class="block text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-1)">
                  SEO Meta Title
                </label>
                <span id="seo-title-count" class="text-[11px] font-mono" style="color: var(--color-text-3)">0 / 60</span>
              </div>
              <input
                type="text"
                id="edit-seo-title"
                maxlength="70"
                class="w-full px-4 py-2.5 rounded-xl border text-xs outline-none transition-all focus:border-emerald-500"
                style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
              />
            </div>
            <div>
              <div class="flex items-center justify-between mb-2">
                <label for="edit-seo-desc" class="block text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-1)">
                  SEO Meta Description
                </label>
                <span id="seo-desc-count" class="text-[11px] font-mono" style="color: var(--color-text-3)">0 / 155</span>
              </div>
              <input
                type="text"
                id="edit-seo-desc"
                maxlength="165"
                class="w-full px-4 py-2.5 rounded-xl border text-xs outline-none transition-all focus:border-emerald-500"
                style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
              />
