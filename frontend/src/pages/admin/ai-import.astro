          </div>
        </div>

        <!-- Tab Content: Image Gallery Staging -->
        <div
          id="tab-panel-images"
          class="hidden p-6 sm:p-7 rounded-2xl border space-y-4"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)"
        >
          <div class="flex items-center justify-between pb-3 border-b" style="border-color: var(--color-border)">
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-1)">Extracted Product Images</h3>
              <p class="text-xs mt-0.5" style="color: var(--color-text-2)">Check images to include in product catalog. Click 'Primary' to designate cover image.</p>
            </div>
            <div class="flex items-center gap-2">
              <input
                type="url"
                id="add-custom-image-input"
                placeholder="https://... custom image URL"
                class="px-3 py-1.5 rounded-lg border text-xs outline-none font-mono"
                style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
              />
              <button
                type="button"
                id="add-custom-image-btn"
                class="text-xs px-3 py-1.5 rounded-lg border font-medium hover:bg-[var(--color-overlay)] text-emerald-400 border-emerald-500/30"
              >
                + Add Image
              </button>
            </div>
          </div>

          <div id="image-gallery-grid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3"></div>
        </div>

        <!-- Tab Content: Factual Audit -->
        <div
          id="tab-panel-audit"
          class="hidden p-6 sm:p-7 rounded-2xl border space-y-4 font-mono text-xs"
          style="background: var(--color-surface); border-color: var(--color-border); box-shadow: var(--shadow-sm)"
        >
          <div class="pb-2 border-b" style="border-color: var(--color-border)">
            <h3 class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-1)">
              Factual Extraction Raw Payload
            </h3>
            <p class="text-[11px] mt-0.5" style="color: var(--color-text-2)">
              Audit the exact data scraped from source markup before Gemini editorial enrichment.
            </p>
          </div>
          <pre
            id="audit-json-viewer"
            class="p-4 rounded-xl overflow-x-auto max-h-96"
            style="background: var(--color-bg); color: var(--color-text-2); border: 1px solid var(--color-border)"
          ></pre>
        </div>

        <!-- Action Bar (Sticky at Bottom) -->
        <div
          class="sticky bottom-4 p-4 rounded-2xl border flex flex-col sm:flex-row items-center justify-between gap-3 backdrop-blur-md z-20"
          style="background: rgba(18, 20, 24, 0.9); border-color: var(--color-border); box-shadow: var(--shadow-lg)"
        >
          <div class="flex items-center gap-2 text-xs" style="color: var(--color-text-2)">
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Review specifications, select category, then choose action.</span>
          </div>

          <div class="flex items-center gap-3 w-full sm:w-auto">
            <button
              type="button"
              id="action-save-draft-btn"
              class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl border text-sm font-semibold transition-all hover:bg-[var(--color-overlay)] cursor-pointer"
              style="border-color: var(--color-border); color: var(--color-text-1)"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              <span>Save as Draft</span>
            </button>

            <button
              type="button"
              id="action-publish-btn"
              class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:opacity-95 shadow cursor-pointer"
              style="background: linear-gradient(135deg, #10b981 0%, #059669 100%)"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Publish Directly</span>
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Bulk Results Workspace (Visible after batch processing) -->
    <div id="bulk-results-workspace" class="hidden space-y-4">
      <div class="flex items-center justify-between pb-2 border-b" style="border-color: var(--color-border)">
        <h2 class="text-sm font-bold uppercase tracking-wider" style="color: var(--color-text-1)">
          Batch Ingestion Results (<span id="bulk-completed-count">0</span>)
        </h2>
        <button
          type="button"
          id="bulk-save-all-drafts-btn"
          class="text-xs px-4 py-2 rounded-xl text-white font-semibold transition-all shadow"
          style="background: linear-gradient(135deg, #10b981 0%, #059669 100%)"
        >
          Save All Valid as Drafts
        </button>
      </div>
      <div id="bulk-results-list" class="space-y-3"></div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from '../../lib/api';
  import { url } from '../../lib/paths';

  // State
  let currentPreviewResult: any = null;
  let activeTab = 'draft';
  let activeMode = 'single';
  let availableCategories: any[] = [];
  let stagedImages: Array<{ url: string; alt: string; selected: boolean; isPrimary: boolean }> = [];
  let stagedSpecs: Array<{ key: string; value: string }> = [];
  let stagedHighlights: string[] = [];

  // DOM Elements
  const urlInput = document.getElementById('product-url-input') as HTMLInputElement;
  const startImportBtn = document.getElementById('start-import-btn') as HTMLButtonElement;
  const btnIconSparkle = document.getElementById('btn-icon-sparkle');
  const btnIconSpinner = document.getElementById('btn-icon-spinner');
  const btnText = document.getElementById('btn-text');

  const modeTabSingle = document.getElementById('mode-tab-single');
  const modeTabBulk = document.getElementById('mode-tab-bulk');
  const inputCardSingle = document.getElementById('input-card-single');
  const inputCardBulk = document.getElementById('input-card-bulk');

  const bulkUrlsInput = document.getElementById('bulk-urls-input') as HTMLTextAreaElement;
  const bulkCounter = document.getElementById('bulk-counter');
  const startBulkBtn = document.getElementById('start-bulk-import-btn') as HTMLButtonElement;

  const stepper = document.getElementById('pipeline-stepper');
  const stagingWorkspace = document.getElementById('staging-workspace');
  const bulkResultsWorkspace = document.getElementById('bulk-results-workspace');

  const diagnosticsPanel = document.getElementById('diagnostics-panel');
  const toggleDiagnosticsBtn = document.getElementById('toggle-diagnostics-btn');
  const closeDiagBtn = document.getElementById('close-diag-btn');
  const refreshDiagBtn = document.getElementById('refresh-diag-btn');
  const headerGeminiStatus = document.getElementById('header-gemini-status');
  const diagSlotsContainer = document.getElementById('diagnostics-slots-container');
  const diagModelPriorityContainer = document.getElementById('diag-model-priority-container');
  const diagLastSuccess = document.getElementById('diag-last-success');
  const diagBreadcrumbTrail = document.getElementById('diag-breadcrumb-trail');

  const confidencePercentage = document.getElementById('confidence-percentage');
  const confidenceLabel = document.getElementById('confidence-label');
  const merchantTag = document.getElementById('merchant-tag');
  const duplicateBadge = document.getElementById('duplicate-status-badge');
  const antiBotBadge = document.getElementById('anti-bot-badge');
  const warningsBanner = document.getElementById('warnings-banner');
  const warningsList = document.getElementById('warnings-list');

  // Form Fields
  const editTitle = document.getElementById('edit-title') as HTMLInputElement;
  const editSlug = document.getElementById('edit-slug') as HTMLInputElement;
  const editBrand = document.getElementById('edit-brand') as HTMLInputElement;
  const editCategory = document.getElementById('edit-category') as HTMLSelectElement;
  const editShortDesc = document.getElementById('edit-short-desc') as HTMLTextAreaElement;
  const editFullDesc = document.getElementById('edit-full-desc') as HTMLTextAreaElement;
  const editCurrentPrice = document.getElementById('edit-current-price') as HTMLInputElement;
  const editOriginalPrice = document.getElementById('edit-original-price') as HTMLInputElement;
  const editAvailability = document.getElementById('edit-availability') as HTMLSelectElement;
  const editCanonicalUrl = document.getElementById('edit-canonical-url') as HTMLInputElement;
  const editSeoTitle = document.getElementById('edit-seo-title') as HTMLInputElement;
  const editSeoDesc = document.getElementById('edit-seo-desc') as HTMLInputElement;
  const seoTitleCount = document.getElementById('seo-title-count');
  const seoDescCount = document.getElementById('seo-desc-count');

  const highlightsContainer = document.getElementById('highlights-container');
  const addHighlightBtn = document.getElementById('add-highlight-btn');
  const specsContainer = document.getElementById('specs-container');
  const addSpecBtn = document.getElementById('add-spec-btn');

  const imageGalleryGrid = document.getElementById('image-gallery-grid');
  const imagesCountBadge = document.getElementById('images-count-badge');
  const addCustomImageInput = document.getElementById('add-custom-image-input') as HTMLInputElement;
  const addCustomImageBtn = document.getElementById('add-custom-image-btn');

  const tabBtnDraft = document.getElementById('tab-btn-draft');
  const tabBtnImages = document.getElementById('tab-btn-images');
  const tabBtnAudit = document.getElementById('tab-btn-audit');
  const tabPanelDraft = document.getElementById('tab-panel-draft');
  const tabPanelImages = document.getElementById('tab-panel-images');
  const tabPanelAudit = document.getElementById('tab-panel-audit');
  const auditJsonViewer = document.getElementById('audit-json-viewer');

  const actionSaveDraftBtn = document.getElementById('action-save-draft-btn');
  const actionPublishBtn = document.getElementById('action-publish-btn');

  // Toast Notification Utility
  function showToast(message: string, type: 'success' | 'error' | 'warning' | 'info' = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `p-4 rounded-xl border text-xs font-medium shadow-lg transition-all transform translate-y-2 pointer-events-auto flex items-center justify-between gap-3 ${
      type === 'success'
        ? 'bg-emerald-950/90 border-emerald-500/40 text-emerald-200'
        : type === 'warning'
        ? 'bg-amber-950/90 border-amber-500/40 text-amber-200'
        : type === 'error'
        ? 'bg-rose-950/90 border-rose-500/40 text-rose-200'
        : 'bg-zinc-900/90 border-zinc-700 text-zinc-200'
    }`;
    toast.innerHTML = `
      <span>${message}</span>
      <button class="opacity-60 hover:opacity-100">&times;</button>
    `;

    toast.querySelector('button')?.addEventListener('click', () => toast.remove());
    container.appendChild(toast);
    setTimeout(() => {
      toast.style.opacity = '0';
      setTimeout(() => toast.remove(), 300);
    }, 4500);
  }

  // Load Categories for Selector
  async function loadCategories() {
    try {
      const res = await api.categories.list();
      availableCategories = res.data || [];
      if (editCategory) {
        editCategory.innerHTML = '<option value="">Select Category...</option>';
        for (const cat of availableCategories) {
          const opt = document.createElement('option');
          opt.value = cat._id || cat.slug;
          opt.textContent = cat.name;
          editCategory.appendChild(opt);
        }
      }
    } catch {
      // Fallback categories
      availableCategories = [
        { name: 'Electronics', slug: 'electronics' },
        { name: 'Audio', slug: 'audio' },
        { name: 'Computing', slug: 'computing' },
      ];
    }
  }

  // Load Key & Model Two-Level Diagnostics
  async function loadDiagnostics() {
    try {
      const res = await api.admin.productImport.diagnostics();
      const diag: any = res.data;
      if (!diag) return;

      if (headerGeminiStatus) {
        const primaryModel = diag.modelPriorityOrder?.[0] || 'gemini-3.8-flash';
        headerGeminiStatus.textContent = `Gemini (${diag.totalHealthyKeys || 0}/${diag.totalConfiguredKeys || 0} Projects | ${primaryModel})`;
      }

      if (diagLastSuccess) {
        if (diag.lastSuccessfulModel && diag.lastSuccessfulSlot) {
          diagLastSuccess.textContent = `${diag.lastSuccessfulModel} (Key ${diag.lastSuccessfulSlot})`;
        } else {
          diagLastSuccess.textContent = 'None yet';
        }
      }

      if (diagBreadcrumbTrail) {
        diagBreadcrumbTrail.textContent = diag.lastAttemptBreadcrumb || 'Ready for failover requests.';
      }

      if (diagModelPriorityContainer && Array.isArray(diag.modelPriorityOrder)) {
        diagModelPriorityContainer.innerHTML = '';
        diag.modelPriorityOrder.forEach((m: string, idx: number) => {
          const badge = document.createElement('span');
          badge.className = 'font-mono text-[11px] font-semibold px-2 py-0.5 rounded border flex items-center gap-1 bg-zinc-800/80 text-zinc-200 border-zinc-700';
          badge.innerHTML = `
            <span class="text-emerald-400 font-bold">${idx + 1}.</span>
            <span>${m}</span>
          `;
          diagModelPriorityContainer.appendChild(badge);
        });
      }

      const keySlots = diag.keySlots || diag.slots || [];
      if (diagSlotsContainer) {
        diagSlotsContainer.innerHTML = '';
        for (const s of keySlots) {
          const card = document.createElement('div');
          card.className = 'p-3.5 rounded-xl border flex flex-col justify-between';
          card.style.background = 'var(--color-bg)';
          card.style.borderColor = s.quotaExhausted
            ? 'rgba(239, 68, 68, 0.4)'
            : s.rateLimited
            ? 'rgba(245, 158, 11, 0.4)'
            : s.healthy && s.configured
            ? 'rgba(16, 185, 129, 0.4)'
            : 'var(--color-border)';

          card.innerHTML = `
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-xs font-bold" style="color: var(--color-text-1)">Key Project Slot ${s.slot}</span>
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded ${
                  !s.configured
                    ? 'bg-zinc-800 text-zinc-400'
                    : s.quotaExhausted
                    ? 'bg-rose-500/20 text-rose-300'
                    : s.rateLimited
                    ? 'bg-amber-500/20 text-amber-300'
                    : s.healthy
                    ? 'bg-emerald-500/20 text-emerald-400'
                    : 'bg-rose-500/20 text-rose-300'
                }">
                  ${
                    !s.configured
                      ? 'Unconfigured'
                      : s.quotaExhausted
                      ? 'Daily Quota Exhausted'
                      : s.rateLimited
                      ? `Cooldown (${s.cooldownSecondsRemaining}s)`
                      : s.healthy
                      ? 'Healthy & Ready'
                      : 'Auth Failure'
                  }
                </span>
              </div>
              <div class="text-[11px]" style="color: var(--color-text-3)">
                ${
                  !s.configured
                    ? 'GEMINI_API_KEY_' + s.slot + ' not set'
                    : s.quotaExhausted
                    ? s.lastError || 'Project daily quota reached'
                    : s.rateLimited
                    ? s.lastError || 'Temporary cooldown active'
                    : s.healthy
                    ? 'Level-2 project pool active'
                    : s.lastError || 'Authentication failure'
                }
              </div>
            </div>
          `;
          diagSlotsContainer.appendChild(card);
        }
      }
    } catch {
      if (headerGeminiStatus) headerGeminiStatus.textContent = 'Gemini Status';
    }
  }

  // Preset Buttons
  document.querySelectorAll('.preset-url-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const sampleUrl = target.getAttribute('data-url');
      if (sampleUrl && urlInput) {
        urlInput.value = sampleUrl;
      }
    });
  });

  // Tab Switching (Draft vs Images vs Audit)
  function switchTab(tab: string) {
    activeTab = tab;
    tabBtnDraft?.classList.toggle('border-emerald-500', tab === 'draft');
    tabBtnDraft?.classList.toggle('text-emerald-400', tab === 'draft');
    tabBtnDraft?.classList.toggle('border-transparent', tab !== 'draft');

    tabBtnImages?.classList.toggle('border-emerald-500', tab === 'images');
    tabBtnImages?.classList.toggle('text-emerald-400', tab === 'images');
    tabBtnImages?.classList.toggle('border-transparent', tab !== 'images');

    tabBtnAudit?.classList.toggle('border-emerald-500', tab === 'audit');
    tabBtnAudit?.classList.toggle('text-emerald-400', tab === 'audit');
    tabBtnAudit?.classList.toggle('border-transparent', tab !== 'audit');

    tabPanelDraft?.classList.toggle('hidden', tab !== 'draft');
    tabPanelImages?.classList.toggle('hidden', tab !== 'images');
    tabPanelAudit?.classList.toggle('hidden', tab !== 'audit');
  }

  tabBtnDraft?.addEventListener('click', () => switchTab('draft'));
  tabBtnImages?.addEventListener('click', () => switchTab('images'));
  tabBtnAudit?.addEventListener('click', () => switchTab('audit'));

  // Mode Switching (Single vs Bulk)
  modeTabSingle?.addEventListener('click', () => {
    activeMode = 'single';
    modeTabSingle.classList.add('border-emerald-500', 'text-emerald-400');
    modeTabSingle.classList.remove('border-transparent');
    modeTabBulk?.classList.remove('border-emerald-500', 'text-emerald-400');
    modeTabBulk?.classList.add('border-transparent');

    inputCardSingle?.classList.remove('hidden');
    inputCardBulk?.classList.add('hidden');
    bulkResultsWorkspace?.classList.add('hidden');
  });

  modeTabBulk?.addEventListener('click', () => {
    activeMode = 'bulk';
    modeTabBulk.classList.add('border-emerald-500', 'text-emerald-400');
    modeTabBulk.classList.remove('border-transparent');
    modeTabSingle?.classList.remove('border-emerald-500', 'text-emerald-400');
    modeTabSingle?.classList.add('border-transparent');

    inputCardBulk?.classList.remove('hidden');
    inputCardSingle?.classList.add('hidden');
    stagingWorkspace?.classList.add('hidden');
  });

  // Diagnostics Toggles
  toggleDiagnosticsBtn?.addEventListener('click', () => {
    diagnosticsPanel?.classList.toggle('hidden');
  });
  closeDiagBtn?.addEventListener('click', () => {
    diagnosticsPanel?.classList.add('hidden');
  });
  refreshDiagBtn?.addEventListener('click', () => {
    loadDiagnostics();
  });

  // SEO Counters
  editSeoTitle?.addEventListener('input', () => {
    if (seoTitleCount) seoTitleCount.textContent = `${editSeoTitle.value.length} / 60`;
  });
  editSeoDesc?.addEventListener('input', () => {
    if (seoDescCount) seoDescCount.textContent = `${editSeoDesc.value.length} / 155`;
  });

  // Dynamic Highlights List Renderer
  function renderHighlights() {
    if (!highlightsContainer) return;
    highlightsContainer.innerHTML = '';
    stagedHighlights.forEach((highlight, idx) => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2';
      row.innerHTML = `
        <span class="w-5 h-5 rounded-full flex items-center justify-center font-bold text-[10px] bg-emerald-500/20 text-emerald-400 shrink-0">${idx + 1}</span>
        <input
          type="text"
          value="${highlight.replace(/"/g, '&quot;')}"
          class="highlight-item-input flex-1 px-3 py-2 rounded-xl border text-xs outline-none focus:border-emerald-500"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        />
        <button
          type="button"
          class="delete-highlight-btn p-2 rounded-lg hover:bg-rose-500/10 text-rose-400 shrink-0"
          data-index="${idx}"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      `;
      highlightsContainer.appendChild(row);
    });

    highlightsContainer.querySelectorAll('.delete-highlight-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        stagedHighlights.splice(idx, 1);
        renderHighlights();
      });
    });

    highlightsContainer.querySelectorAll('.highlight-item-input').forEach((input, idx) => {
      input.addEventListener('change', (e) => {
        stagedHighlights[idx] = (e.target as HTMLInputElement).value;
      });
    });
  }

  addHighlightBtn?.addEventListener('click', () => {
    stagedHighlights.push('New key feature');
    renderHighlights();
  });

  // Dynamic Specifications Table Renderer
  function renderSpecs() {
    if (!specsContainer) return;
    specsContainer.innerHTML = '';
    stagedSpecs.forEach((spec, idx) => {
      const row = document.createElement('div');
      row.className = 'grid grid-cols-1 sm:grid-cols-12 gap-2 items-center';
      row.innerHTML = `
        <input
          type="text"
          value="${spec.key.replace(/"/g, '&quot;')}"
          placeholder="Specification (e.g. Battery)"
          class="spec-key-input sm:col-span-4 px-3 py-2 rounded-xl border text-xs outline-none focus:border-emerald-500 font-semibold"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        />
        <input
          type="text"
          value="${spec.value.replace(/"/g, '&quot;')}"
          placeholder="Value (e.g. 5000 mAh)"
          class="spec-val-input sm:col-span-7 px-3 py-2 rounded-xl border text-xs outline-none focus:border-emerald-500"
          style="background: var(--color-bg); border-color: var(--color-border); color: var(--color-text-1)"
        />
        <button
          type="button"
          class="delete-spec-btn sm:col-span-1 p-2 rounded-lg hover:bg-rose-500/10 text-rose-400 flex items-center justify-center"
          data-index="${idx}"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      `;
      specsContainer.appendChild(row);
    });

    specsContainer.querySelectorAll('.delete-spec-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        stagedSpecs.splice(idx, 1);
        renderSpecs();
      });
    });

    specsContainer.querySelectorAll('.spec-key-input').forEach((input, idx) => {
      input.addEventListener('change', (e) => {
        stagedSpecs[idx].key = (e.target as HTMLInputElement).value;
      });
    });

    specsContainer.querySelectorAll('.spec-val-input').forEach((input, idx) => {
      input.addEventListener('change', (e) => {
        stagedSpecs[idx].value = (e.target as HTMLInputElement).value;
      });
    });
  }

  addSpecBtn?.addEventListener('click', () => {
    stagedSpecs.push({ key: '', value: '' });
    renderSpecs();
  });

  // Image Gallery Staging Renderer
  function renderImages() {
    if (!imageGalleryGrid) return;
    imageGalleryGrid.innerHTML = '';
    if (imagesCountBadge) imagesCountBadge.textContent = String(stagedImages.filter((img) => img.selected).length);

    stagedImages.forEach((img, idx) => {
      const card = document.createElement('div');
      card.className = `relative rounded-xl border p-2 flex flex-col items-center justify-between transition-all ${
        img.selected ? 'border-emerald-500 bg-emerald-500/5' : 'border-zinc-800 opacity-50'
      }`;

      card.innerHTML = `
        <div class="relative w-full aspect-square rounded-lg overflow-hidden bg-black/40 flex items-center justify-center mb-2">
          <img src="${img.url}" alt="${img.alt}" class="w-full h-full object-contain" loading="lazy" />
          ${img.isPrimary ? '<span class="absolute top-1 left-1 bg-emerald-500 text-black text-[9px] font-bold px-1.5 py-0.5 rounded">PRIMARY</span>' : ''}
        </div>
        <div class="flex items-center justify-between w-full text-xs">
          <label class="flex items-center gap-1 cursor-pointer">
            <input type="checkbox" class="img-toggle-chk" data-index="${idx}" ${img.selected ? 'checked' : ''} />
            <span class="text-[10px]">Use</span>
          </label>
          <button type="button" class="img-primary-btn text-[10px] font-semibold text-emerald-400 hover:underline" data-index="${idx}">
            Set Primary
          </button>
        </div>
      `;

      imageGalleryGrid.appendChild(card);
    });

    imageGalleryGrid.querySelectorAll('.img-toggle-chk').forEach((chk) => {
      chk.addEventListener('change', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        stagedImages[idx].selected = (e.target as HTMLInputElement).checked;
        renderImages();
      });
    });

    imageGalleryGrid.querySelectorAll('.img-primary-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
        stagedImages.forEach((img, i) => {
          img.isPrimary = i === idx;
          if (i === idx) img.selected = true;
        });
        renderImages();
      });
    });
  }

  addCustomImageBtn?.addEventListener('click', () => {
    const customUrl = addCustomImageInput?.value.trim();
    if (customUrl && customUrl.startsWith('http')) {
      stagedImages.push({ url: customUrl, alt: 'Custom Product Image', selected: true, isPrimary: stagedImages.length === 0 });
      if (addCustomImageInput) addCustomImageInput.value = '';
      renderImages();
    }
  });

  // Populate Staging Workspace with Extracted + Enriched Result
  function populateWorkspace(result: any) {
    currentPreviewResult = result;
    const { factual, enriched, confidenceScore, duplicateCheck, warnings } = result;

    // Show Workspace
    stagingWorkspace?.classList.remove('hidden');
    stepper?.classList.remove('hidden');

    // Confidence
    if (confidencePercentage) confidencePercentage.textContent = `${confidenceScore}%`;
    if (confidenceLabel) {
      if (confidenceScore >= 80) confidenceLabel.textContent = 'High confidence: verified factual specs & images';
      else if (confidenceScore >= 50) confidenceLabel.textContent = 'Moderate confidence: check specs & pricing carefully';
      else confidenceLabel.textContent = 'Low confidence: verify fields before publishing';
    }

    // Merchant Badge
    if (merchantTag) {
      merchantTag.textContent = factual.merchantName || factual.merchantType;
    }

    // Enrichment Source Badge (Gemini vs Heuristic Fallback)
    const isHeuristicFallback = Array.isArray(warnings) && warnings.some((w: string) => 
      w.toLowerCase().includes('heuristic') || 
      w.toLowerCase().includes('fallback') ||
      w.toLowerCase().includes('gemini rotation warning')
    );

    const enrichmentSourceBadge = document.getElementById('enrichment-source-badge');
    const enrichmentSourceDot = document.getElementById('enrichment-source-dot');
    const enrichmentSourceText = document.getElementById('enrichment-source-text');
    const stepGemini = document.getElementById('step-gemini');

    if (enrichmentSourceBadge && enrichmentSourceDot && enrichmentSourceText) {
      if (isHeuristicFallback) {
        enrichmentSourceBadge.className = 'text-xs font-semibold px-3 py-1 rounded-full border bg-amber-500/15 text-amber-300 border-amber-500/30 flex items-center gap-1.5';
        enrichmentSourceDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-400';
        enrichmentSourceText.textContent = 'Heuristic Fallback (Gemini Exhausted)';
      } else {
        enrichmentSourceBadge.className = 'text-xs font-semibold px-3 py-1 rounded-full border bg-emerald-500/15 text-emerald-300 border-emerald-500/30 flex items-center gap-1.5';
        enrichmentSourceDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
        enrichmentSourceText.textContent = 'Gemini AI Enriched';
      }
    }

    if (stepGemini) {
      if (isHeuristicFallback) {
        stepGemini.innerHTML = `
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-bold text-[10px] bg-amber-500/20 text-amber-400">4</span>
          <span class="font-medium text-amber-300">Heuristic Fallback</span>
        `;
      } else {
        stepGemini.innerHTML = `
          <span class="w-5 h-5 rounded-full flex items-center justify-center font-bold text-[10px] bg-emerald-500/20 text-emerald-400">4</span>
          <span class="font-medium" style="color: var(--color-text-2)">Gemini AI Enrichment</span>
        `;
      }
    }

    // Duplicate Badge
    if (duplicateBadge) {
      if (duplicateCheck?.isDuplicate) {
        duplicateBadge.classList.remove('hidden');
        duplicateBadge.textContent = `Existing Catalog Match: ${duplicateCheck.duplicateProductTitle || 'Duplicate'}`;
      } else {
        duplicateBadge.classList.add('hidden');
      }
    }

    // Anti-bot Badge
    if (antiBotBadge) {
      if (factual.isAntiBotBlocked) antiBotBadge.classList.remove('hidden');
      else antiBotBadge.classList.add('hidden');
    }

    // Warnings Banner
    if (warningsBanner && warningsList) {
      if (warnings && warnings.length > 0) {
        warningsBanner.classList.remove('hidden');
        warningsList.innerHTML = warnings.map((w: string) => `<li>${w}</li>`).join('');
      } else {
        warningsBanner.classList.add('hidden');
      }
    }

    // Fill Form Fields
    if (editTitle) editTitle.value = enriched.title || factual.rawTitle || '';
    if (editSlug) editSlug.value = enriched.slug || '';
    if (editBrand) editBrand.value = enriched.brand || factual.brand || '';
    if (editShortDesc) editShortDesc.value = enriched.shortDescription || '';
    if (editFullDesc) editFullDesc.value = enriched.fullDescription || '';
    if (editCurrentPrice) editCurrentPrice.value = factual.price !== undefined ? String(factual.price) : '';
    if (editOriginalPrice) editOriginalPrice.value = factual.originalPrice !== undefined ? String(factual.originalPrice) : '';
    if (editAvailability) editAvailability.value = factual.availability || 'unknown';
    if (editCanonicalUrl) editCanonicalUrl.value = factual.canonicalUrl || factual.url || '';
    if (editSeoTitle) {
      editSeoTitle.value = enriched.seoTitle || '';
      if (seoTitleCount) seoTitleCount.textContent = `${editSeoTitle.value.length} / 60`;
    }
    if (editSeoDesc) {
      editSeoDesc.value = enriched.seoDescription || '';
      if (seoDescCount) seoDescCount.textContent = `${editSeoDesc.value.length} / 155`;
    }

    // Category matching
    if (editCategory && enriched.suggestedCategorySlug) {
      const match = availableCategories.find(
        (c) => c.slug === enriched.suggestedCategorySlug || c.name.toLowerCase() === enriched.suggestedCategorySlug.toLowerCase()
      );
      if (match) {
        editCategory.value = match._id || match.slug;
      }
    }

    // Dynamic Highlights & Specs
    stagedHighlights = [...(enriched.highlights || factual.features || [])];
    renderHighlights();

    stagedSpecs = (enriched.specifications?.length ? enriched.specifications : factual.specifications) || [];
    renderSpecs();

    // Staged Images
    stagedImages = (factual.images || []).map((img: any, i: number) => ({
      url: img.url,
      alt: img.alt || enriched.title,
      selected: true,
      isPrimary: i === 0,
    }));
    renderImages();

    // Raw Audit JSON
    if (auditJsonViewer) {
      auditJsonViewer.textContent = JSON.stringify({ factual, duplicateCheck, warnings }, null, 2);
    }

    // Scroll to workspace smoothly
    stagingWorkspace?.scrollIntoView({ behavior: 'smooth' });
  }

  // Handle Single Product Import Submit
  startImportBtn?.addEventListener('click', async () => {
    const targetUrl = urlInput.value.trim();
    if (!targetUrl) {
      showToast('Please enter a valid product URL.', 'error');
      return;
    }

    // UI Loading state
    startImportBtn.disabled = true;
    btnIconSparkle?.classList.add('hidden');
    btnIconSpinner?.classList.remove('hidden');
    if (btnText) btnText.textContent = 'Extracting & AI Enriching...';
    stepper?.classList.remove('hidden');

    try {
      const res = await api.admin.productImport.preview(targetUrl);
      const result: any = res.data;
      populateWorkspace(result);
      const isFallback = Array.isArray(result.warnings) && result.warnings.some((w: string) => 
        w.toLowerCase().includes('heuristic') || 
        w.toLowerCase().includes('fallback') ||
        w.toLowerCase().includes('gemini rotation warning')
      );
      if (isFallback) {
        showToast('Product extracted using Heuristic Fallback (Gemini models exhausted).', 'warning');
      } else {
        showToast('Product successfully extracted and enriched with Gemini!', 'success');
      }
      loadDiagnostics();
    } catch (err: any) {
      showToast(err.message || 'Import failed. Check URL and server connectivity.', 'error');
    } finally {
      startImportBtn.disabled = false;
      btnIconSparkle?.classList.remove('hidden');
      btnIconSpinner?.classList.add('hidden');
      if (btnText) btnText.textContent = 'Extract & Enrich with AI';
    }
  });

  // Bulk URLs Count Tracker
  bulkUrlsInput?.addEventListener('input', () => {
    const urls = bulkUrlsInput.value
      .split('\n')
      .map((u) => u.trim())
      .filter((u) => u.length > 5);
    if (bulkCounter) bulkCounter.textContent = `${urls.length} / 10 URLs detected`;
  });

  // Handle Bulk Batch Import
  startBulkBtn?.addEventListener('click', async () => {
    const urls = bulkUrlsInput.value
      .split('\n')
      .map((u) => u.trim())
      .filter((u) => u.length > 5);

    if (urls.length === 0) {
      showToast('Please paste at least one URL.', 'error');
      return;
    }
    if (urls.length > 10) {
      showToast('Maximum 10 URLs allowed per batch.', 'error');
      return;
    }

    startBulkBtn.disabled = true;
    startBulkBtn.textContent = `Processing ${urls.length} URLs...`;

    try {
      const res = await api.admin.productImport.bulkPreview(urls);
      const items: any[] = (res.data as any[]) || [];

      bulkResultsWorkspace?.classList.remove('hidden');
      const completedCount = document.getElementById('bulk-completed-count');
      if (completedCount) completedCount.textContent = String(items.length);

      const bulkList = document.getElementById('bulk-results-list');
      if (bulkList) {
        bulkList.innerHTML = '';
        items.forEach((item, idx) => {
          const card = document.createElement('div');
          card.className = 'p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3';
          card.style.background = 'var(--color-surface)';
          card.style.borderColor = 'var(--color-border)';

          const isItemFallback = Array.isArray(item.warnings) && item.warnings.some((w: string) => 
            w.toLowerCase().includes('heuristic') || 
            w.toLowerCase().includes('fallback')
          );

          card.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full flex items-center justify-center font-bold text-xs bg-emerald-500/20 text-emerald-400 shrink-0">${idx + 1}</span>
              <div>
                <div class="text-sm font-semibold flex items-center gap-2" style="color: var(--color-text-1)">
                  <span>${item.enriched?.title || item.factual?.rawTitle || 'Untitled'}</span>
                  ${isItemFallback ? '<span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30">Fallback</span>' : ''}
                </div>
                <div class="text-xs font-mono" style="color: var(--color-text-3)">${item.url}</div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-lg ${
                item.confidenceScore >= 75 ? 'bg-emerald-500/15 text-emerald-400' : 'bg-amber-500/15 text-amber-300'
              }">${item.confidenceScore}%</span>
              <button
                type="button"
                class="bulk-inspect-btn px-3 py-1.5 rounded-lg border text-xs font-semibold hover:bg-[var(--color-overlay)]"
                style="border-color: var(--color-border); color: var(--color-text-1)"
                data-index="${idx}"
              >
                Inspect & Edit
              </button>
            </div>
          `;
          bulkList.appendChild(card);
        });

        bulkList.querySelectorAll('.bulk-inspect-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
            populateWorkspace(items[idx]);
          });
        });
      }

      showToast(`Batch completed: ${items.length} products processed.`, 'success');
      loadDiagnostics();
    } catch (err: any) {
      showToast(err.message || 'Bulk batch failed.', 'error');
    } finally {
      startBulkBtn.disabled = false;
      startBulkBtn.textContent = 'Process Batch with AI';
    }
  });

  // Build Payload from Staging Form
  function buildPayload() {
    const selectedImages = stagedImages
      .filter((img) => img.selected)
      .map((img) => ({ url: img.url, alt: img.alt || editTitle.value }));

    if (selectedImages.length === 0 && stagedImages.length > 0) {
      selectedImages.push({ url: stagedImages[0].url, alt: editTitle.value });
    }

    const priceNum = editCurrentPrice.value ? parseFloat(editCurrentPrice.value) : undefined;
    const origPriceNum = editOriginalPrice.value ? parseFloat(editOriginalPrice.value) : undefined;

    return {
      title: editTitle.value.trim(),
      slug: editSlug.value.trim(),
      brand: editBrand.value.trim(),
      categoryId: editCategory.value || null,
      shortDescription: editShortDesc.value.trim(),
      fullDescription: editFullDesc.value.trim(),
      images: selectedImages,
      highlights: stagedHighlights.filter((h) => h.trim().length > 0),
      specifications: stagedSpecs.filter((s) => s.key.trim().length > 0),
      searchKeywords: currentPreviewResult?.enriched?.searchKeywords || [],
      tags: currentPreviewResult?.enriched?.tags || [],
      seoTitle: editSeoTitle.value.trim(),
      seoDescription: editSeoDesc.value.trim(),
      canonicalUrl: editCanonicalUrl.value.trim(),
      offer: {
        productUrl: currentPreviewResult?.factual?.url || editCanonicalUrl.value.trim(),
        currentPrice: priceNum,
        originalPrice: origPriceNum,
        currency: 'INR',
        availability: editAvailability.value,
      },
    };
  }

  // Save as Draft
  actionSaveDraftBtn?.addEventListener('click', async () => {
    const payload = buildPayload();
    if (!payload.title) {
      showToast('Title is required.', 'error');
      return;
    }
    if (payload.images.length === 0) {
      showToast('At least one product image is required.', 'error');
      return;
    }

    actionSaveDraftBtn.setAttribute('disabled', 'true');
    try {
      await api.admin.productImport.saveDraft(payload);
      showToast('Product successfully saved to catalog as Draft!', 'success');
      setTimeout(() => {
        window.location.href = url('/admin/products');
      }, 1200);
    } catch (err: any) {
      showToast(err.message || 'Failed to save product draft.', 'error');
      actionSaveDraftBtn.removeAttribute('disabled');
    }
  });

  // Publish Directly
  actionPublishBtn?.addEventListener('click', async () => {
    const payload = buildPayload();
    if (!payload.title) {
      showToast('Title is required.', 'error');
      return;
    }
    if (payload.images.length === 0) {
      showToast('At least one product image is required.', 'error');
      return;
    }

    actionPublishBtn.setAttribute('disabled', 'true');
    try {
      await api.admin.productImport.publish(payload);
      showToast('Product successfully published to the live platform!', 'success');
      setTimeout(() => {
        window.location.href = url('/admin/products');
      }, 1200);
    } catch (err: any) {
      showToast(err.message || 'Failed to publish product.', 'error');
      actionPublishBtn.removeAttribute('disabled');
    }
  });

  // Initialization
  loadCategories();
  loadDiagnostics();
</script>

