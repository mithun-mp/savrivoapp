---
import MainLayout from '../../layouts/MainLayout.astro';
import ProductDetailView from '../../components/product/ProductDetailView';
import { getBuildProducts } from '../../lib/products.data';
import { API_BASE } from '../../lib/api';
import type { Product, Offer, Category } from '../../types';

export async function getStaticPaths() {
  const products = await getBuildProducts();
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props as { product: Product };

let offers: Offer[] = product.offers && product.offers.length > 0 ? [...product.offers] : [];
let relatedProducts: Product[] = [];
try {
  const catId = typeof product.categoryId === 'object' ? (product.categoryId as Category)?._id : product.categoryId;
  const [productDetailRes, relRes] = await Promise.all([
    fetch(`${API_BASE}/products/${product.slug}`, { signal: AbortSignal.timeout(5000) }),
    fetch(`${API_BASE}/products?limit=6${catId ? `&category=${catId}` : ''}`, { signal: AbortSignal.timeout(4000) }),
  ]);

  if (productDetailRes.ok) {
    const json = await productDetailRes.json();
    if (json?.data?.offers && Array.isArray(json.data.offers) && json.data.offers.length > 0) {
      offers = json.data.offers;
    }
  }

  if (relRes.ok) {
    const j = await relRes.json();
    relatedProducts = (j.data || []).filter((p2: Product) => p2._id !== product._id).slice(0, 4);
  }
} catch {
  // If API fetch fails during static generation, default to empty offers (offers will load or fallback on client)
}

const categoryName = typeof product.categoryId === 'object' && product.categoryId ? (product.categoryId as Category).name : '';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "description": product.shortDescription || '',
  "brand": product.brand ? { "@type": "Brand", "name": product.brand } : undefined,
  "image": product.images?.[0]?.url,
  "offers": offers.length > 0 ? offers.map(o => ({
    "@type": "Offer",
    "price": o.currentPrice || undefined,
    "priceCurrency": o.currency || 'INR',
    "availability": o.availability === 'in_stock' ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    "url": o.affiliateUrl || o.productUrl,
  })) : undefined,
};
---

<MainLayout
  title={product.seoTitle || `${product.title} — Review & Deals | SAVRIVO`}
  description={product.seoDescription || product.shortDescription || `Find verified retailer offers and specifications for ${product.title} on SAVRIVO.`}
  canonicalUrl={product.canonicalUrl || `https://savrivo.in/product/${product.slug}`}
  ogImage={product.images?.[0]?.url}
  ogType="product"
  structuredData={structuredData}
>
  <ProductDetailView
    client:load
    product={product}
    initialOffers={offers}
    relatedProducts={relatedProducts}
  />
</MainLayout>
