# ==============================================================================
# SAVRIVO Backend — Environment Configuration Example
# Copy this file to .env and provide your deployment secrets.
# NEVER commit the actual .env file or production credentials to Git.
# ==============================================================================

# Server Environment & Port
# Set to 'production' on Render. Defaults to 'development' locally.
NODE_ENV=development
PORT=4000

# MongoDB Atlas Connection URI
# Cluster: SAVRIVO (Project 0) | Host: savrivo.qlvie1u.mongodb.net | DB: savrivo
# Replace <DB_PASSWORD> with the password for user mithunmpmail_db_user
MONGODB_URI=mongodb+srv://mithunmpmail_db_user:<DB_PASSWORD>@savrivo.qlvie1u.mongodb.net/savrivo?retryWrites=true&w=majority&appName=SAVRIVO

# JWT Authentication for Editorial Admin Portal
# Generate a cryptographically secure random secret (64+ characters) in production
JWT_SECRET=replace-with-64-plus-char-random-secret-here-abcdefghijklmnopqrstuvwxyz1234
JWT_EXPIRES_IN=7d

# Primary Editorial Admin Configuration
# Optional default email for interactive administrator provisioning CLI.
# The primary administrator account is created interactively via Render Shell or CLI.
# Passwords are entered interactively with masked input. Never store passwords in environment variables.
ADMIN_EMAIL=admin@savrivo.in

# Frontend Origins Allowed by CORS (Comma-separated for multiple origins)
# GitHub Pages origin https://mithun-mp.github.io covers both /savrivo and /savrivoapp
FRONTEND_ORIGIN=http://localhost:4321,https://mithun-mp.github.io

# External Merchant Integration: Amazon Associates (India)
AMAZON_ASSOCIATE_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_MARKETPLACE=www.amazon.in

# External Merchant Integration: Flipkart Affiliate API
FLIPKART_AFFILIATE_ID=
FLIPKART_TOKEN=

# SMTP Email Dispatch (Transactional Contact Forms)
CONTACT_EMAIL_HOST=
CONTACT_EMAIL_PORT=587
CONTACT_EMAIL_USER=
CONTACT_EMAIL_PASS=
CONTACT_EMAIL_TO=hello@savrivo.in